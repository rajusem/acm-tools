# Generated manifests
manifests/*.yaml

# Must-gather output
must-gather-*/

# Secrets (keep .example, ignore actual secrets)
# Glob rather than exact names: pull secrets arrive under several prefixes
# (pull-secret.json, art-pull-secret.json, ...) and an exact-match entry
# silently leaves the new one committable.
install-custom-acm/*pull-secret*.json
*.kubeconfig
auto-import-secret*

# Temp files
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.code-workspace

# Local AI agent tooling (not .claude/, which holds shared skills)
.agents/
.codex/

# Logs
*.log

# Local MCP server config
.mcp.json
