# =============================================================================
# Phase 9e: NamespaceBinding change (MCOA mode)
# =============================================================================

phase_9e() {
    if release_is_216; then
        PHASE_SKIP_REASON="Not applicable to ACM 2.16 (MCO-only; no MCOA support)"
        return 2
    fi
    local errors=0

    ensure_mco_installed || { PHASE_FAIL_REASON="MCO not installed or not ready"; return 1; }
    ensure_mode mcoa || { PHASE_FAIL_REASON="Failed to switch to MCOA mode"; return 1; }

    log_substep "Ensuring both RS features enabled"
    patch_rs_features true true

    wait_until "$TIMEOUT_E2E_RECONCILE" 5 "MCOA configmap creation" \
        resource_exists configmap rs-namespace-config "$OBS_NAMESPACE" || true

    log_substep "Creating test namespace $RS_BINDING_TEST_NS"
    kube_retry $KUBE_CLI create namespace "$RS_BINDING_TEST_NS" 2>/dev/null || true

    log_substep "Patching namespaceBinding to $RS_BINDING_TEST_NS"
    patch_rs_namespace_binding "$RS_BINDING_TEST_NS" "$RS_BINDING_TEST_NS"

    wait_for_reconcile 30 "MCO reconcile after binding change"

    log_substep "Verifying no Policies in $RS_BINDING_TEST_NS (MCOA mode)"
    assert_not_exists policy rs-prom-rules-policy "$RS_BINDING_TEST_NS" || ((errors++)) || true
    assert_not_exists policy rs-virt-prom-rules-policy "$RS_BINDING_TEST_NS" || ((errors++)) || true

    log_substep "Verifying no Policies in $GLOBAL_SET_NAMESPACE (MCOA mode)"
    assert_not_exists policy rs-prom-rules-policy "$GLOBAL_SET_NAMESPACE" || ((errors++)) || true
    assert_not_exists policy rs-virt-prom-rules-policy "$GLOBAL_SET_NAMESPACE" || ((errors++)) || true

    log_substep "Verifying ManifestWork PrometheusRules unaffected"
    count_mw_prometheusrules || true
    if [[ $MW_PR_COUNT -gt 0 ]]; then
        log_success "  ManifestWorks: $MW_PR_COUNT RS PrometheusRule(s) (unaffected)"
    else
        log_warn "  ManifestWorks: 0 RS PrometheusRules (MCOA may not have generated them — not a binding issue)"
    fi

    log_substep "Verifying ConfigMaps unchanged in $OBS_NAMESPACE"
    assert_exists configmap rs-namespace-config "$OBS_NAMESPACE" || ((errors++)) || true
    assert_exists configmap rs-virt-config "$OBS_NAMESPACE" || ((errors++)) || true

    log_substep "Resetting namespaceBinding to default"
    patch_rs_namespace_binding "" ""

    log_substep "Cleaning up test namespace"
    kube_retry $KUBE_CLI delete namespace "$RS_BINDING_TEST_NS" --ignore-not-found 2>/dev/null || true

    CURRENT_MODE="mcoa"

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="$errors assertion(s) failed during MCOA namespaceBinding change"
        return 1
    fi
    return 0
}

# =============================================================================
# Phase 4 & 10: ConfigMap Propagation
# =============================================================================

phase_4() {
    if release_is_50; then
        PHASE_SKIP_REASON="Not applicable to ACM 5.0 (MCOA-only; ConfigMap propagation via phase 10)"
        return 2
    fi
    local errors=0

    ensure_mco_installed || { PHASE_FAIL_REASON="MCO not installed or not ready"; return 1; }
    ensure_mode mco || { PHASE_FAIL_REASON="Failed to switch to MCO mode"; return 1; }

    log_substep "Modifying rs-namespace-config: recommendationPercentage 110 -> 120"
    # MCO stores prometheusRuleConfig as YAML; MCOA stores it as JSON.
    # Handle both: try JSON parse first, fall back to YAML gsub.
    local _json
    _json=$(kube_retry $KUBE_CLI get configmap rs-namespace-config -n "$OBS_NAMESPACE" -o json | \
        jq '.data.prometheusRuleConfig |= (. as $v | try ($v | fromjson | .recommendationPercentage = 120 | tojson) catch ($v | gsub("recommendationPercentage: 110"; "recommendationPercentage: 120")))')
    kube_apply_json "$_json"

    # MCO renders the percentage in PrometheusRule expr as "(120/100)".
    wait_until "$TIMEOUT_E2E_RECONCILE" 5 "Policy update" \
        policy_contains rs-prom-rules-policy "$GLOBAL_SET_NAMESPACE" "120/100" || true

    log_substep "Checking PrometheusRule in Policy contains updated percentage"
    local policy_json
    policy_json=$(kube_retry $KUBE_CLI get policy rs-prom-rules-policy -n "$GLOBAL_SET_NAMESPACE" -o json 2>/dev/null || echo "{}")
    if echo "$policy_json" | jq -e '.. | objects | select(.kind=="PrometheusRule") | .spec.groups[]?.rules[]?.expr | select(test("120/100"))' >/dev/null 2>&1; then
        log_success "  Policy PrometheusRule expr contains (120/100)"
    else
        log_error "  Policy PrometheusRule does not contain (120/100) in expr"
        ((errors++)) || true
    fi

    log_substep "Reverting: recommendationPercentage 120 -> 110"
    _json=$(kube_retry $KUBE_CLI get configmap rs-namespace-config -n "$OBS_NAMESPACE" -o json | \
        jq '.data.prometheusRuleConfig |= (. as $v | try ($v | fromjson | .recommendationPercentage = 110 | tojson) catch ($v | gsub("recommendationPercentage: 120"; "recommendationPercentage: 110")))')
    kube_apply_json "$_json"

    CURRENT_MODE="mco"

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="ConfigMap change not propagated to Policy"
        return 1
    fi
    return 0
}

phase_10() {
    if release_is_216; then
        PHASE_SKIP_REASON="Not applicable to ACM 2.16 (MCO-only; no MCOA support)"
        return 2
    fi
    local errors=0

    ensure_mco_installed || { PHASE_FAIL_REASON="MCO not installed or not ready"; return 1; }
    ensure_mode mcoa || { PHASE_FAIL_REASON="Failed to switch to MCOA mode"; return 1; }

    log_substep "Modifying rs-namespace-config: recommendationPercentage 110 -> 120"
    # MCO stores prometheusRuleConfig as YAML; MCOA stores it as JSON.
    # Handle both: try JSON parse first, fall back to YAML gsub.
    local _json
    _json=$(kube_retry $KUBE_CLI get configmap rs-namespace-config -n "$OBS_NAMESPACE" -o json | \
        jq '.data.prometheusRuleConfig |= (. as $v | try ($v | fromjson | .recommendationPercentage = 120 | tojson) catch ($v | gsub("recommendationPercentage: 110"; "recommendationPercentage: 120")))')
    kube_apply_json "$_json"

    # MCOA Watcher watches RS ConfigMaps and calls addonManager.Trigger() for all clusters.
    # The percentage appears in PrometheusRule expr as "(120/100)".
    wait_until 120 5 "ManifestWork update" \
        manifestwork_contains "120/100" || true

    log_substep "Checking PrometheusRule in ManifestWork contains updated percentage"
    local found_120=false
    local mc_list
    mc_list=$(kube_retry $KUBE_CLI get managedcluster -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || echo "")
    for mc in $mc_list; do
        for mw in $(kube_retry $KUBE_CLI get manifestwork -n "$mc" -o name 2>/dev/null | grep "$MCOA_MW_PATTERN" || true); do
            if kube_retry $KUBE_CLI get "$mw" -n "$mc" -o json 2>/dev/null | \
                jq -e '[.spec.workload.manifests[]? | select(.kind=="PrometheusRule") | .spec.groups[]?.rules[]?.expr | select(test("120/100"))] | length > 0' >/dev/null 2>&1; then
                found_120=true
                log_success "  $mc: PrometheusRule expr contains (120/100)"
                break 2
            fi
        done
    done
    if [[ "$found_120" == "false" ]]; then
        log_error "  No PrometheusRule in ManifestWorks contains (120/100)"
        ((errors++)) || true
    fi

    log_substep "Reverting: recommendationPercentage 120 -> 110"
    _json=$(kube_retry $KUBE_CLI get configmap rs-namespace-config -n "$OBS_NAMESPACE" -o json | \
        jq '.data.prometheusRuleConfig |= (. as $v | try ($v | fromjson | .recommendationPercentage = 110 | tojson) catch ($v | gsub("recommendationPercentage: 120"; "recommendationPercentage: 110")))')
    kube_apply_json "$_json"

    CURRENT_MODE="mcoa"

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="ConfigMap change not propagated to ManifestWork"
        return 1
    fi
    return 0
}

# =============================================================================
# Phase 4a: ConfigMap Coexistence (MCO+MCOA)
# =============================================================================

phase_4a() {
    if release_is_50 || release_is_216; then
        PHASE_SKIP_REASON="Not applicable to ACM $RS_RELEASE (MCO+MCOA coexistence only valid in 2.17)"
        return 2
    fi
    local errors=0

    ensure_mco_installed || { PHASE_FAIL_REASON="MCO not installed or not ready"; return 1; }
    ensure_mode mco || { PHASE_FAIL_REASON="Failed to ensure MCO mode"; return 1; }

    log_substep "Verifying RS ConfigMaps exist (baseline)"
    assert_exists configmap rs-namespace-config "$OBS_NAMESPACE" || { PHASE_FAIL_REASON="Baseline RS ConfigMaps missing"; return 1; }
    assert_exists configmap rs-virt-config "$OBS_NAMESPACE" || { PHASE_FAIL_REASON="Baseline RS ConfigMaps missing"; return 1; }

    log_substep "Enabling incident detection to trigger MCOA deployment"
    kube_retry $KUBE_CLI patch mco "$MCO_NAME" --type=merge -p '{
        "spec":{"capabilities":{"platform":{"analytics":{"incidentDetection":{"enabled":true}}}}}
    }'

    log_substep "Waiting for MCOA deployment"
    wait_until 120 10 "MCOA deployment" \
        $KUBE_CLI rollout status deployment/$MCOA_DEPLOY -n "$OBS_NAMESPACE" --timeout=5s \
        || log_warn "MCOA deployment rollout timed out — continuing"

    if ! $KUBE_CLI get deployment "$MCOA_DEPLOY" -n "$OBS_NAMESPACE" &>/dev/null; then
        PHASE_FAIL_REASON="MCOA deployment not created after enabling incident detection"
        kube_retry $KUBE_CLI patch mco "$MCO_NAME" --type=merge -p '{
            "spec":{"capabilities":{"platform":{"analytics":{"incidentDetection":{"enabled":false}}}}}
        }'
        return 1
    fi
    log_success "  MCOA deployment ready"

    log_substep "Checking ADC delegation signal"
    wait_until 30 5 "ADC delegation sync" \
        verify_adc_delegation "false" || true
    verify_adc_delegation "false" || ((errors++)) || true

    log_substep "Verifying RS ConfigMaps survived MCOA deployment"
    assert_exists configmap rs-namespace-config "$OBS_NAMESPACE" || ((errors++)) || true
    assert_exists configmap rs-virt-config "$OBS_NAMESPACE" || ((errors++)) || true

    log_substep "Waiting 30s and re-checking ConfigMaps (catch delayed deletion)"
    sleep 30
    assert_exists configmap rs-namespace-config "$OBS_NAMESPACE" || ((errors++)) || true
    assert_exists configmap rs-virt-config "$OBS_NAMESPACE" || ((errors++)) || true

    log_substep "Verifying no RS ManifestWork PrometheusRules (MCO uses Policy)"
    count_mw_prometheusrules "true"
    if [[ $MW_PR_COUNT -gt 0 ]]; then
        log_error "  ManifestWorks: $MW_PR_COUNT RS PrometheusRule(s) — should be 0 in MCO mode"
        ((errors++)) || true
    else
        log_success "  ManifestWorks: 0 RS PrometheusRules (correct for MCO mode)"
    fi

    log_substep "Verifying no RS Perses dashboards (MCO mode)"
    for db in "$RS_NS_DASHBOARD" "${RS_VM_DASHBOARDS[@]}"; do
        if perses_dashboard_exists "$db"; then
            log_error "  persesdashboard/$db EXISTS — should not be created in MCO mode"
            ((errors++)) || true
        else
            log_success "  persesdashboard/$db absent (correct for MCO mode)"
        fi
    done

    log_substep "Reverting: disabling incident detection"
    kube_retry $KUBE_CLI patch mco "$MCO_NAME" --type=merge -p '{
        "spec":{"capabilities":{"platform":{"analytics":{"incidentDetection":{"enabled":false}}}}}
    }'
    wait_for_reconcile 30 "Waiting for MCO reconciliation after revert"

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="MCOA leaked RS resources in MCO mode — delegation signal not working"
        return 1
    fi
    return 0
}

# =============================================================================
# Phase 15-16: MCO Reinstall After MCOA
# =============================================================================

phase_15() {
    if release_is_50 || release_is_216; then
        PHASE_SKIP_REASON="Not applicable to ACM $RS_RELEASE (MCOA reinstall test only valid in 2.17)"
        return 2
    fi
    if ! e2e_confirm "Phase 15 will delete MCO in MCOA mode and reinstall. Continue?"; then
        PHASE_SKIP_REASON="user declined"
        return 2
    fi

    local errors=0

    ensure_mco_installed || { PHASE_FAIL_REASON="MCO not installed or not ready"; return 1; }
    ensure_mode mcoa || { PHASE_FAIL_REASON="Failed to switch to MCOA mode"; return 1; }

    log_substep "Enabling both RS features"
    patch_rs_features true true
    wait_until "$TIMEOUT_E2E_RECONCILE" 5 "RS resource creation" \
        resource_exists configmap rs-namespace-config "$OBS_NAMESPACE" || true

    log_substep "Deleting MCO (MCOA mode)"
    echo "y" | "$SCRIPT_DIR/setup-observability" uninstall

    log_substep "Verifying RS cleanup"
    wait_until "$TIMEOUT_RS_CLEANUP" 5 "RS resource cleanup" \
        not_resource_exists configmap rs-namespace-config "$OBS_NAMESPACE" || true
    verify_all_rs_resources_deleted "uninstall" || ((errors++)) || true

    log_substep "Reinstalling MCO"
    "$SCRIPT_DIR/setup-observability" install --force-cleanup-mw
    ensure_mco_installed || { PHASE_FAIL_REASON="MCO reinstall failed"; return 1; }

    CURRENT_MODE=$(get_current_mode)
    log_info "  Post-reinstall mode: $CURRENT_MODE"

    if [[ "$CURRENT_MODE" != "mco" ]]; then
        log_error "  Expected MCO mode after reinstall, got: $CURRENT_MODE"
        ((errors++)) || true
    else
        log_success "  MCO starts in default MCO mode"
    fi

    log_substep "Waiting for RS auto-defaults"
    wait_until 90 5 "RS auto-defaults" rs_defaults_populated || true

    local ns_enabled
    ns_enabled=$(get_resource_field mco "$MCO_NAME" "" \
        '{.spec.capabilities.platform.analytics.namespaceRightSizingRecommendation.enabled}' || echo "")
    if [[ "$ns_enabled" == "true" ]]; then
        log_success "  RS features auto-enabled"
    else
        log_error "  RS features not auto-enabled after reinstall"
        ((errors++)) || true
        patch_rs_features true true
        wait_until "$TIMEOUT_E2E_RECONCILE" 5 "RS resource creation" \
            resource_exists placement rs-placement "$GLOBAL_SET_NAMESPACE" || true
    fi

    log_substep "Checking for stale IsMCOTerminating"
    local terminating
    terminating=$($KUBE_CLI logs deploy/multicluster-observability-operator \
        -n "$ACM_NAMESPACE" --tail=20 2>/dev/null | \
        grep "MCO is terminating, skip reconcile" || true)
    if [[ -n "$terminating" ]]; then
        log_error "  Stale IsMCOTerminating detected after reinstall"
        ((errors++)) || true
    else
        log_success "  No stale IsMCOTerminating flag"
    fi

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="$errors issue(s) after reinstall"
        return 1
    fi
    return 0
}

phase_16() {
    if release_is_50 || release_is_216; then
        PHASE_SKIP_REASON="Not applicable to ACM $RS_RELEASE (mode switch after reinstall only valid in 2.17)"
        return 2
    fi
    local errors=0

    ensure_mco_installed || { PHASE_FAIL_REASON="MCO not installed or not ready"; return 1; }
    ensure_mode mco || { PHASE_FAIL_REASON="Failed to switch to MCO mode"; return 1; }

    log_substep "Switching to MCOA mode"
    $KUBE_CLI annotate mco "$MCO_NAME" "$RS_ANNOTATION=true" --overwrite
    CURRENT_MODE="mcoa"
    wait_until "$TIMEOUT_E2E_MODE_SWITCH" 5 "MCOA mode" \
        adc_not_mco_mode || true
    log_substep "Waiting for MCOA to auto-detect ADC change"
    if ! wait_until 60 5 "ManifestWork auto-generation" mw_has_rs_prometheusrules; then
        log_warn "MCOA did not auto-reconcile after ADC change — restarting as fallback"
        kube_retry $KUBE_CLI rollout restart deployment/$MCOA_DEPLOY -n "$OBS_NAMESPACE" 2>/dev/null || true
        $KUBE_CLI rollout status deployment/$MCOA_DEPLOY \
            -n "$OBS_NAMESPACE" --timeout="${TIMEOUT_ROLLOUT}s" 2>/dev/null || \
            log_warn "MCOA rollout status timed out — continuing"
        wait_for_reconcile 30 "Waiting for ManifestWork generation"
    fi

    log_substep "Verifying MCOA mode active"
    assert_not_exists policy rs-prom-rules-policy "$GLOBAL_SET_NAMESPACE" || ((errors++)) || true
    assert_exists configmap rs-namespace-config "$OBS_NAMESPACE" || ((errors++)) || true

    log_substep "Checking specHash populated"
    verify_spec_hashes_populated || ((errors++)) || true

    log_substep "Checking ManifestWork PrometheusRules"
    count_mw_prometheusrules || ((errors += MW_PR_ERRORS)) || true
    if [[ $MW_PR_COUNT -eq 0 && $MW_PR_ERRORS -eq 0 ]]; then
        log_error "  ManifestWorks: 0 RS PrometheusRules"
        ((errors++)) || true
    elif [[ $MW_PR_COUNT -gt 0 ]]; then
        log_success "  ManifestWorks: $MW_PR_COUNT RS PrometheusRule(s)"
    fi

    log_substep "Checking ADC state"
    verify_adc_state "enabled" "enabled" || ((errors++)) || true

    verify_perses_dashboards "true" "true" || ((errors++)) || true

    log_substep "Switching back to MCO mode"
    $KUBE_CLI annotate mco "$MCO_NAME" "$RS_ANNOTATION-" --overwrite 2>/dev/null || true

    wait_until "$TIMEOUT_E2E_MODE_SWITCH" 5 "MCO mode restoration" \
        mco_placements_ready || true
    sleep 20
    wait_until 30 5 "placement stabilization" mco_placements_ready || true

    log_substep "Verifying MCO mode restored"
    assert_exists policy rs-prom-rules-policy "$GLOBAL_SET_NAMESPACE" || ((errors++)) || true
    assert_exists policy rs-virt-prom-rules-policy "$GLOBAL_SET_NAMESPACE" || ((errors++)) || true

    CURRENT_MODE="mco"
    log_substep "Checking ADC state"
    verify_adc_state "disabled" "disabled" || ((errors++)) || true

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="ADC not synced to disabled after mode switch"
        return 1
    fi
    return 0
}

# =============================================================================
# Phase 17-22: Data-plane Validation
# =============================================================================

phase_17() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi

    local ctx="$NAMESPACE_SPOKE_CONTEXT"
    local errors=0

    log_substep "Checking namespace spoke connectivity"
    if ! $KUBE_CLI --context="$ctx" cluster-info \
            --request-timeout=10s &>/dev/null 2>&1; then
        PHASE_FAIL_REASON="Namespace spoke $ctx unreachable"
        return 1
    fi
    log_success "  Spoke $ctx reachable"

    log_substep "Checking RS PrometheusRules on spoke"
    local pr_count
    pr_count=$($KUBE_CLI --context="$ctx" get prometheusrules -n openshift-monitoring \
        --no-headers 2>/dev/null | grep -c 'acm-rs' || true)
    if [[ "$pr_count" -eq 0 ]]; then
        PHASE_FAIL_REASON="No RS PrometheusRules on spoke — RS features must be enabled (run phases 0-1 first)"
        return 1
    fi
    log_success "  $pr_count RS PrometheusRule(s) on spoke"

    log_substep "Deploying CronJob workloads to $RS_NS_WORKLOAD_NS"
    deploy_namespace_workloads

    log_substep "Verifying CronJob count"
    local count
    count=$($KUBE_CLI --context="$ctx" get cronjobs \
        -n "$RS_NS_WORKLOAD_NS" --no-headers 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$count" -ge 5 ]]; then
        log_success "  $count CronJobs deployed"
    else
        log_error "  Expected 5 CronJobs, found $count"
        PHASE_FAIL_REASON="Incomplete CronJob deployment: $count/5"
        return 1
    fi

    log_substep "Deploying classification workloads (overestimated + ideal)"
    deploy_classification_workloads

    log_substep "Verifying classification Deployments"
    for pair in "$RS_NS_OVERESTIMATED_NS:idle-overestimated" "$RS_NS_IDEAL_NS:ideal-range"; do
        local ns="${pair%%:*}" dep="${pair##*:}"
        if $KUBE_CLI --context="$NAMESPACE_SPOKE_CONTEXT" get deployment "$dep" -n "$ns" &>/dev/null; then
            log_success "  $dep in $ns: exists"
        else
            log_error "  $dep in $ns: not found"
            ((errors++)) || true
        fi
    done

    return 0
}

phase_18() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi
    if [[ "$SKIP_VM" == "true" ]]; then
        PHASE_SKIP_REASON="--skip-vm"
        return 2
    fi

    local ctx="$VM_SPOKE_CONTEXT"

    log_substep "Checking VM spoke connectivity"
    if ! $KUBE_CLI --context="$ctx" cluster-info \
            --request-timeout=10s &>/dev/null 2>&1; then
        PHASE_FAIL_REASON="VM spoke $ctx unreachable"
        return 1
    fi
    log_success "  Spoke $ctx reachable"

    log_substep "Checking OpenShift Virtualization on VM spoke"
    if ! spoke_has_virtualization "$ctx"; then
        PHASE_SKIP_REASON="OpenShift Virtualization not installed on $ctx"
        return 2
    fi
    log_success "  OpenShift Virtualization installed"

    log_substep "Deploying VMs to $RS_VM_WORKLOAD_NS"
    deploy_vm_workloads

    log_substep "Verifying VM count"
    local vm_count
    vm_count=$($KUBE_CLI --context="$ctx" get vm \
        -n "$RS_VM_WORKLOAD_NS" --no-headers 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$vm_count" -ge 2 ]]; then
        log_success "  $vm_count VMs deployed"
    else
        log_error "  Expected >= 2 VMs, found $vm_count"
        PHASE_FAIL_REASON="Incomplete VM deployment: $vm_count VMs"
        return 1
    fi

    return 0
}

phase_19() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi
    if [[ "$NO_METRICS_WAIT" == "true" ]]; then
        log_info "  Skipping metrics wait (--no-metrics-wait)"
        return 0
    fi

    log_info "  Waiting ${TIMEOUT_METRICS_WAIT}s for Thanos to ingest metrics"
    log_info "  (5m rules evaluate every 5m, 1d rules every 15m, remote-write every ~5m)"
    wait_with_message "$TIMEOUT_METRICS_WAIT" "Waiting for Thanos to ingest metrics"
    return 0
}

phase_20() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi

    switch_context "$HUB_CONTEXT" || { PHASE_FAIL_REASON="Cannot switch to hub context"; return 1; }

    # Pre-check: verify classification namespaces exist on spoke
    for ns in "$RS_NS_OVERESTIMATED_NS" "$RS_NS_IDEAL_NS"; do
        if ! $KUBE_CLI --context="$NAMESPACE_SPOKE_CONTEXT" get namespace "$ns" &>/dev/null 2>&1; then
            PHASE_FAIL_REASON="Namespace $ns not found on $NAMESPACE_SPOKE_CONTEXT — run phase 17 first"
            return 1
        fi
    done

    log_substep "Discovering Thanos endpoint"
    if ! discover_thanos_endpoint; then
        PHASE_FAIL_REASON="No Thanos endpoint found on hub"
        return 1
    fi
    log_success "  Thanos endpoint: $THANOS_URL"

    THANOS_TOKEN=$($KUBE_CLI whoami -t 2>/dev/null || echo "")

    local errors=0

    # Namespace classification pairs: (namespace, expected_class, cpu_mode, mem_mode)
    # cpu_mode/mem_mode: "hard" or "soft"
    local -a ns_tests=(
        "$RS_NS_WORKLOAD_NS:underestimated:soft:soft"
        "$RS_NS_OVERESTIMATED_NS:overestimated:hard:hard"
        "$RS_NS_IDEAL_NS:ideal:skip:hard"
    )

    for entry in "${ns_tests[@]}"; do
        IFS=: read -r ns expected_class cpu_mode mem_mode <<< "$entry"
        log_substep "Checking metrics for $ns (expected: $expected_class)"

        local val_cpu_request="" val_cpu_usage="" val_cpu_recommendation=""
        local val_memory_request="" val_memory_usage="" val_memory_recommendation=""
        for metric in cpu_request cpu_usage cpu_recommendation memory_request memory_usage memory_recommendation; do
            local full_metric="acm_rs:namespace:${metric}"
            local value
            value=$(thanos_query_metric "$full_metric" "namespace=\"$ns\"")
            if [[ -n "$value" ]]; then
                eval "val_${metric}=\"$value\""
                log_success "  $full_metric = $value"
            else
                log_error "  $full_metric: no data"
                ((errors++)) || true
            fi
        done

        # Memory classification
        local mem_failed=false
        if [[ -n "$val_memory_request" && -n "$val_memory_recommendation" ]]; then
            local soft_flag="false"
            if [[ "$mem_mode" == "soft" ]]; then soft_flag="true"; fi
            assert_classification "memory" "$expected_class" \
                "$val_memory_recommendation" "$val_memory_request" "$ns" "$soft_flag" || \
                mem_failed=true
        fi

        # CPU classification
        local cpu_failed=false
        if [[ "$cpu_mode" == "skip" ]]; then
            log_info "  Skipping CPU classification for $ns (not controllable)"
        elif [[ -n "$val_cpu_request" && -n "$val_cpu_recommendation" ]]; then
            local soft_flag="false"
            if [[ "$cpu_mode" == "soft" ]]; then soft_flag="true"; fi
            assert_classification "cpu" "$expected_class" \
                "$val_cpu_recommendation" "$val_cpu_request" "$ns" "$soft_flag" || \
                cpu_failed=true
        fi

        # Spoke Prometheus fallback — verify with tier-1 if hub classification fails
        if [[ "$mem_failed" == "true" || "$cpu_failed" == "true" ]]; then
            if [[ -z "$SPOKE_THANOS_HOST" ]]; then
                spoke_discover_thanos "$NAMESPACE_SPOKE_CONTEXT" || true
            fi
            if [[ -n "$SPOKE_THANOS_HOST" ]]; then
                log_info "  Falling back to spoke Prometheus (tier-1) for $ns"
                local spoke_mem_req spoke_mem_usage spoke_mem_rec spoke_cpu_req spoke_cpu_usage spoke_cpu_rec
                spoke_mem_req=$(spoke_query_metric "acm_rs:namespace:memory_request:5m" "namespace=\"$ns\"")
                spoke_mem_usage=$(spoke_query_metric "acm_rs:namespace:memory_usage:5m" "namespace=\"$ns\"")
                spoke_cpu_req=$(spoke_query_metric "acm_rs:namespace:cpu_request:5m" "namespace=\"$ns\"")
                spoke_cpu_usage=$(spoke_query_metric "acm_rs:namespace:cpu_usage:5m" "namespace=\"$ns\"")
                # recommendation:5m doesn't exist at tier-1 — compute from usage * (rp/100)
                local rp
                rp=$($KUBE_CLI get configmap rs-namespace-config -n "$OBS_NAMESPACE" \
                    -o jsonpath='{.data.prometheusRuleConfig}' --request-timeout=10s 2>/dev/null | \
                    jq -r '.recommendationPercentage // 110' 2>/dev/null || echo "110")
                spoke_mem_rec=""
                if [[ -n "$spoke_mem_usage" ]]; then
                    spoke_mem_rec=$(awk "BEGIN {printf \"%.0f\", $spoke_mem_usage * ($rp / 100)}")
                fi
                spoke_cpu_rec=""
                if [[ -n "$spoke_cpu_usage" ]]; then
                    spoke_cpu_rec=$(awk "BEGIN {printf \"%.6f\", $spoke_cpu_usage * ($rp / 100)}")
                fi

                local spoke_resolved=true
                if [[ "$mem_failed" == "true" && -n "$spoke_mem_req" && -n "$spoke_mem_rec" ]]; then
                    log_info "  Spoke tier-1: memory_request=$(format_bytes "$spoke_mem_req")"
                    local spoke_soft="false"
                    if [[ "$mem_mode" == "soft" ]]; then spoke_soft="true"; fi
                    if assert_classification "memory" "$expected_class" \
                        "$spoke_mem_rec" "$spoke_mem_req" "$ns (spoke)" "$spoke_soft"; then
                        log_info "  Note: Hub has stale tier-2 data. Spoke confirms correct classification. Converges within 24h."
                        mem_failed=false
                    fi
                fi
                if [[ "$cpu_failed" == "true" && "$cpu_mode" != "skip" && -n "$spoke_cpu_req" && -n "$spoke_cpu_rec" ]]; then
                    log_info "  Spoke tier-1: cpu_request=$spoke_cpu_req"
                    local spoke_soft="false"
                    if [[ "$cpu_mode" == "soft" ]]; then spoke_soft="true"; fi
                    if assert_classification "cpu" "$expected_class" \
                        "$spoke_cpu_rec" "$spoke_cpu_req" "$ns (spoke)" "$spoke_soft"; then
                        cpu_failed=false
                    fi
                fi
            else
                log_warn "  Cannot reach spoke Prometheus to verify tier-1 data"
            fi
        fi

        if [[ "$mem_failed" == "true" ]]; then ((errors++)) || true; fi
        if [[ "$cpu_failed" == "true" ]]; then ((errors++)) || true; fi
    done

    stop_thanos_port_forward

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="$errors namespace metric(s) missing or classification mismatch"
        return 1
    fi
    return 0
}

phase_21() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi
    if [[ "$SKIP_VM" == "true" ]]; then
        PHASE_SKIP_REASON="--skip-vm"
        return 2
    fi

    switch_context "$HUB_CONTEXT" || { PHASE_FAIL_REASON="Cannot switch to hub context"; return 1; }

    # Pre-check: verify VMs exist
    if ! $KUBE_CLI --context="$VM_SPOKE_CONTEXT" get namespace "$RS_VM_WORKLOAD_NS" &>/dev/null 2>&1; then
        PHASE_FAIL_REASON="VM namespace $RS_VM_WORKLOAD_NS not found on $VM_SPOKE_CONTEXT — run phase 18 first"
        return 1
    fi

    if [[ -z "${THANOS_URL:-}" ]]; then
        log_substep "Discovering Thanos endpoint"
        if ! discover_thanos_endpoint; then
            PHASE_FAIL_REASON="No Thanos endpoint found on hub"
            return 1
        fi
    fi

    THANOS_TOKEN=$($KUBE_CLI whoami -t 2>/dev/null || echo "")

    local errors=0

    # VM classification pairs: (vm_name, expected_class, soft, expected_mem_request_gi)
    # NOTE: this phase uses the RATIO classifier (classify_recommendation: ratio>1.2 under, <0.8 over).
    # Under that classifier, VM underestimation cannot register: max ratio = 1.1 (100% utilization ×
    # 110% recommendation) never exceeds the 1.2 "underestimated" threshold, so only ideal +
    # overestimated appear here. The dashboard's floor-based panels use a DIFFERENT rule
    # (floor(request - reco) < 0, i.e. usage > request/1.1 ≈ 90.9%), under which underestimation IS
    # achievable — that is validated separately in phase_21a with the cpu-underest-vm / mem-underest-vm
    # fixtures. Do not "fix" this list to expect underestimated here.
    local -a vm_tests=(
        "fedora-vm-1:ideal:false:4"
        "fedora-vm-2:overestimated:false:4"
        "rhel-vm1:ideal:true:4"
    )

    for entry in "${vm_tests[@]}"; do
        IFS=: read -r vm_name expected_class is_soft expected_mem_gi <<< "$entry"
        local label_selector="name=\"$vm_name\",namespace=\"$RS_VM_WORKLOAD_NS\""

        log_substep "Checking VM $vm_name (expected: $expected_class)"

        local val_cpu_request="" val_cpu_usage="" val_cpu_recommendation=""
        local val_memory_request="" val_memory_usage="" val_memory_recommendation=""
        local metric_errors=0
        for metric in cpu_request cpu_usage cpu_recommendation memory_request memory_usage memory_recommendation; do
            local full_metric="acm_rs_vm:namespace:${metric}"
            local value
            value=$(thanos_query_metric "$full_metric" "$label_selector")
            if [[ -n "$value" ]]; then
                eval "val_${metric}=\"$value\""
                log_success "  $full_metric = $value"
            else
                if [[ "$is_soft" == "true" ]]; then
                    log_warn "  $full_metric: no data (soft)"
                else
                    log_error "  $full_metric: no data"
                    ((metric_errors++)) || true
                fi
            fi
        done

        if [[ $metric_errors -gt 0 ]]; then
            ((errors += metric_errors)) || true
            continue
        fi

        # Memory request sanity check (detect KubeVirt source label doubling)
        local spoke_fallback_needed=false
        if [[ -n "$val_memory_request" ]]; then
            local expected_bytes=$(( expected_mem_gi * 1073741824 ))
            local max_acceptable
            max_acceptable=$(awk "BEGIN {printf \"%.0f\", $expected_bytes * 1.5}")
            if awk "BEGIN {exit !($val_memory_request > $max_acceptable)}"; then
                log_warn "  Hub Thanos: memory_request=$(format_bytes "$val_memory_request") exceeds 1.5x expected $(format_bytes "$expected_bytes") (stale tier-2 data, falling back to spoke)"
                spoke_fallback_needed=true
            else
                log_success "  memory_request=$(format_bytes "$val_memory_request") within expected range (spec: ${expected_mem_gi}Gi)"
            fi
        fi

        # Spoke Prometheus fallback — query tier-1 :5m metrics directly
        if [[ "$spoke_fallback_needed" == "true" ]]; then
            if [[ -z "$SPOKE_THANOS_HOST" ]]; then
                spoke_discover_thanos "$VM_SPOKE_CONTEXT" || true
            fi
            if [[ -n "$SPOKE_THANOS_HOST" ]]; then
                local spoke_mem_req spoke_mem_usage spoke_mem_rec spoke_cpu_req spoke_cpu_usage spoke_cpu_rec
                spoke_mem_req=$(spoke_query_metric "acm_rs_vm:namespace:memory_request:5m" "name=\"$vm_name\",namespace=\"$RS_VM_WORKLOAD_NS\"")
                spoke_mem_usage=$(spoke_query_metric "acm_rs_vm:namespace:memory_usage:5m" "name=\"$vm_name\",namespace=\"$RS_VM_WORKLOAD_NS\"")
                spoke_cpu_req=$(spoke_query_metric "acm_rs_vm:namespace:cpu_request:5m" "name=\"$vm_name\",namespace=\"$RS_VM_WORKLOAD_NS\"")
                spoke_cpu_usage=$(spoke_query_metric "acm_rs_vm:namespace:cpu_usage:5m" "name=\"$vm_name\",namespace=\"$RS_VM_WORKLOAD_NS\"")
                # recommendation:5m doesn't exist at tier-1 — compute from usage * (rp/100)
                local rp
                rp=$($KUBE_CLI get configmap rs-namespace-config -n "$OBS_NAMESPACE" \
                    -o jsonpath='{.data.prometheusRuleConfig}' --request-timeout=10s 2>/dev/null | \
                    jq -r '.recommendationPercentage // 110' 2>/dev/null || echo "110")
                spoke_mem_rec=""
                if [[ -n "$spoke_mem_usage" ]]; then
                    spoke_mem_rec=$(awk "BEGIN {printf \"%.0f\", $spoke_mem_usage * ($rp / 100)}")
                fi
                spoke_cpu_rec=""
                if [[ -n "$spoke_cpu_usage" ]]; then
                    spoke_cpu_rec=$(awk "BEGIN {printf \"%.6f\", $spoke_cpu_usage * ($rp / 100)}")
                fi

                if [[ -n "$spoke_mem_req" ]]; then
                    if awk "BEGIN {exit !($spoke_mem_req <= $max_acceptable)}"; then
                        log_success "  Spoke Prometheus (tier-1): memory_request=$(format_bytes "$spoke_mem_req") — fix active"
                        log_info "  Note: Hub data will converge within 24h as max_over_time([1d]) ages out"
                        # Re-run classification with spoke values
                        if [[ -n "$spoke_mem_rec" ]]; then
                            assert_classification "memory" "$expected_class" \
                                "$spoke_mem_rec" "$spoke_mem_req" "$vm_name (spoke)" "$is_soft" || \
                                ((errors++)) || true
                        fi
                        if [[ -n "$spoke_cpu_req" && -n "$spoke_cpu_rec" ]]; then
                            local spoke_cpu_class
                            spoke_cpu_class=$(classify_recommendation "$spoke_cpu_rec" "$spoke_cpu_req")
                            local spoke_cpu_ratio
                            spoke_cpu_ratio=$(awk "BEGIN {printf \"%.3f\", $spoke_cpu_rec / $spoke_cpu_req}")
                            log_info "  Spoke CPU: $spoke_cpu_class (ratio=$spoke_cpu_ratio) — informational"
                        fi
                    else
                        log_error "  Spoke Prometheus (tier-1): memory_request=$(format_bytes "$spoke_mem_req") — also inflated, fix not applied"
                        ((errors++)) || true
                    fi
                else
                    log_warn "  Spoke Prometheus: no tier-1 data for $vm_name (rules may not have evaluated yet)"
                    ((errors++)) || true
                fi
            else
                log_warn "  Cannot reach spoke Prometheus to verify tier-1. Wait 24h for hub data to converge, or check spoke manually."
                ((errors++)) || true
            fi
        else
            # Hub data was fine — run classification normally
            # Memory classification assertion
            if [[ -n "$val_memory_request" && -n "$val_memory_recommendation" ]]; then
                assert_classification "memory" "$expected_class" \
                    "$val_memory_recommendation" "$val_memory_request" "$vm_name" "$is_soft" || \
                    ((errors++)) || true
            fi
        fi

        # CPU classification — informational only under the ratio classifier (cpu usage is capped at
        # the vCPU count, so ratio maxes at 1.1 and never reaches the 1.2 "underestimated" cutoff).
        # Floor-based CPU underestimation (usage > request/1.1) is validated in phase_21a instead.
        if [[ "$spoke_fallback_needed" != "true" && -n "$val_cpu_request" && -n "$val_cpu_recommendation" ]]; then
            local cpu_class
            cpu_class=$(classify_recommendation "$val_cpu_recommendation" "$val_cpu_request")
            local cpu_ratio
            cpu_ratio=$(awk "BEGIN {printf \"%.3f\", $val_cpu_recommendation / $val_cpu_request}")
            log_info "  $vm_name cpu: $cpu_class (ratio=$cpu_ratio) — VM CPU capped at vCPU count"
        fi
    done

    stop_thanos_port_forward

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="$errors VM metric(s) missing or classification mismatch"
        return 1
    fi
    return 0
}

# =============================================================================
# Phase 21a: VM Dashboard Stat vs Table Query Consistency
# Validates that stat panel queries (total overestimation/underestimation)
# produce values consistent with sum(table panel per-VM values).
# Source: multicluster-observability-addon/internal/perses/panels/rightsizing/vm-panels.go
# Stat panels: lines 72-134 (VMTotalCPU/MemOverestimation/UnderestimationPanel)
# Table panels: lines 181-344 (query #5 = overestimation/underestimation column)
# If queries change in vm-panels.go, update these templates.
# =============================================================================

# Stat panel PromQL templates (with running VM filter)
STAT_CPU_OVEREST_TMPL='sum(
(floor(max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])-
max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])) > 0)
and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)'

STAT_CPU_UNDEREST_TMPL='sum(
(floor(max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])-
max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])) < 0) * (-1)
and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)'

STAT_MEM_OVEREST_TMPL='(sum(
(floor((max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:]) / 1073741824)-
(max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:]) / 1073741824)) > 0)
and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)) * 1073741824'

STAT_MEM_UNDEREST_TMPL='(sum(
(floor((max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:]) / 1073741824)-
(max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:]) / 1073741824)) < 0) * (-1)
and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)) * 1073741824'

# Table panel PromQL templates (with running VM filter, stripped label_join, wrapped in sum)
TABLE_CPU_OVEREST_TMPL='sum(
floor(max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])-max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:]))
> 0 and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)'

TABLE_CPU_UNDEREST_TMPL='sum(
(floor(max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])-max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:cpu_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])) * (-1))
> 0 and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)'

TABLE_MEM_OVEREST_TMPL='sum(
(floor((max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])) / 1073741824 - (max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])) / 1073741824)) * 1073741824
> 0 and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)'

TABLE_MEM_UNDEREST_TMPL='sum(
((floor((max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_request{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])) / 1073741824 - (max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace"})[$days:])) / 1073741824)) * (-1)) * 1073741824
> 0 and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)
)'

subst_dashboard_vars() {
    local tmpl="$1" cluster="$2" profile="$3" namespace="$4" days="$5"
    echo "$tmpl" | sed \
        -e "s/\\\$cluster/$cluster/g" \
        -e "s/\\\$profile/$profile/g" \
        -e "s/\\\$namespace/$namespace/g" \
        -e "s/\\\$days/$days/g"
}

assert_stat_table_match() {
    local label="$1" stat_val="$2" table_val="$3" stat_query="$4" table_query="$5"

    if [[ -z "$stat_val" && -z "$table_val" ]]; then
        log_success "  $label: MATCH (both empty — no VMs in this category)"
        return 0
    fi

    if [[ -z "$stat_val" ]]; then
        log_error "  $label: MISMATCH stat=empty vs table_sum=$table_val"
        log_error "    stat query:  $stat_query"
        log_error "    table query: $table_query"
        return 1
    fi

    if [[ -z "$table_val" ]]; then
        log_error "  $label: MISMATCH stat=$stat_val vs table_sum=empty"
        log_error "    stat query:  $stat_query"
        log_error "    table query: $table_query"
        return 1
    fi

    local match
    match=$(awk "BEGIN {d = $stat_val - $table_val; if (d < 0) d = -d; print (d < 0.01) ? \"yes\" : \"no\"}")
    if [[ "$match" == "yes" ]]; then
        log_success "  $label: MATCH stat=$stat_val table_sum=$table_val"
        return 0
    else
        local delta pct
        delta=$(awk "BEGIN {d = $stat_val - $table_val; if (d < 0) d = -d; printf \"%.2f\", d}")
        pct=$(awk "BEGIN {if ($table_val != 0) printf \"%.1f\", (($stat_val - $table_val) / $table_val) * 100; else print \"inf\"}")
        log_error "  $label: MISMATCH stat=$stat_val vs table_sum=$table_val delta=$delta ($pct%)"
        log_error "    stat query:  $stat_query"
        log_error "    table query: $table_query"
        return 1
    fi
}

phase_21a() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi
    if [[ "$SKIP_VM" == "true" ]]; then
        PHASE_SKIP_REASON="--skip-vm"
        return 2
    fi

    switch_context "$HUB_CONTEXT" || { PHASE_FAIL_REASON="Cannot switch to hub context"; return 1; }

    if ! $KUBE_CLI --context="$VM_SPOKE_CONTEXT" get namespace "$RS_VM_WORKLOAD_NS" &>/dev/null 2>&1; then
        PHASE_FAIL_REASON="VM namespace $RS_VM_WORKLOAD_NS not found on $VM_SPOKE_CONTEXT — run phase 18 first"
        return 1
    fi

    log_substep "Pre-check: checking test VM running state"
    local stopped_count=0
    for vm in fedora-vm-1 fedora-vm-2 rhel-vm1 cpu-underest-vm mem-underest-vm; do
        if vm_is_running "$VM_SPOKE_CONTEXT" "$RS_VM_WORKLOAD_NS" "$vm"; then
            log_success "  $vm: Running"
        else
            log_warn "  $vm: not Running"
            ((stopped_count++)) || true
        fi
    done
    if [[ $stopped_count -gt 0 ]]; then
        log_warn "  $stopped_count VM(s) not running — stat/table values will exclude them (both use running VM filter)"
    fi

    if [[ -z "${THANOS_URL:-}" ]]; then
        log_substep "Discovering Thanos endpoint"
        if ! discover_thanos_endpoint; then
            PHASE_FAIL_REASON="No Thanos endpoint found on hub"
            return 1
        fi
    fi
    THANOS_TOKEN=$($KUBE_CLI whoami -t 2>/dev/null || echo "")

    local cluster="$VM_SPOKE_CONTEXT"
    local profile="Max OverAll"
    local namespace="$RS_VM_WORKLOAD_NS"
    local days="1d"
    local errors=0

    log_substep "Comparing stat vs table queries (cluster=$cluster, namespace=$namespace)"

    local -a pairs=(
        "CPU Overestimation:STAT_CPU_OVEREST_TMPL:TABLE_CPU_OVEREST_TMPL"
        "CPU Underestimation:STAT_CPU_UNDEREST_TMPL:TABLE_CPU_UNDEREST_TMPL"
        "Memory Overestimation:STAT_MEM_OVEREST_TMPL:TABLE_MEM_OVEREST_TMPL"
        "Memory Underestimation:STAT_MEM_UNDEREST_TMPL:TABLE_MEM_UNDEREST_TMPL"
    )

    # Track the underestimation stat values so we can assert the dedicated fixtures actually fired
    # (assert_stat_table_match treats "both empty" as a trivial MATCH — that would silently pass even
    # if the cpu-underest-vm / mem-underest-vm fixtures failed to load or stopped underestimating).
    local cpu_underest_stat="" mem_underest_stat=""

    for entry in "${pairs[@]}"; do
        IFS=: read -r label stat_tmpl_name table_tmpl_name <<< "$entry"

        local stat_query table_query
        stat_query=$(subst_dashboard_vars "${!stat_tmpl_name}" "$cluster" "$profile" "$namespace" "$days")
        table_query=$(subst_dashboard_vars "${!table_tmpl_name}" "$cluster" "$profile" "$namespace" "$days")

        local stat_val table_val
        stat_val=$(thanos_query_promql "$stat_query")
        table_val=$(thanos_query_promql "$table_query")

        assert_stat_table_match "$label" "$stat_val" "$table_val" "$stat_query" "$table_query" || \
            ((errors++)) || true

        [[ "$label" == "CPU Underestimation" ]] && cpu_underest_stat="$stat_val"
        [[ "$label" == "Memory Underestimation" ]] && mem_underest_stat="$stat_val"
    done

    # Explicit non-empty coverage: the cpu-underest-vm and mem-underest-vm fixtures are deployed by
    # phase 18 specifically to make these panels fire. If they are running (pre-check above) but the
    # stat is empty/zero, the fixture is not underestimating (metrics not federated yet, fill failed,
    # or the recording-rule semantics changed) — fail loudly instead of passing as "both empty".
    if vm_is_running "$VM_SPOKE_CONTEXT" "$RS_VM_WORKLOAD_NS" cpu-underest-vm; then
        if [[ -n "$cpu_underest_stat" ]] && awk "BEGIN {exit !($cpu_underest_stat > 0)}"; then
            log_success "  CPU Underestimation: fixture cpu-underest-vm is underestimating (stat=$cpu_underest_stat)"
        else
            log_error "  CPU Underestimation: cpu-underest-vm running but stat='${cpu_underest_stat:-empty}' (expected > 0)"
            ((errors++)) || true
        fi
    else
        log_warn "  CPU Underestimation: cpu-underest-vm not running — skipping non-empty assertion"
    fi

    if vm_is_running "$VM_SPOKE_CONTEXT" "$RS_VM_WORKLOAD_NS" mem-underest-vm; then
        if [[ -n "$mem_underest_stat" ]] && awk "BEGIN {exit !($mem_underest_stat > 0)}"; then
            log_success "  Memory Underestimation: fixture mem-underest-vm is underestimating (stat=$(format_bytes "$mem_underest_stat"))"
        else
            log_error "  Memory Underestimation: mem-underest-vm running but stat='${mem_underest_stat:-empty}' (expected > 0)"
            ((errors++)) || true
        fi
    else
        log_warn "  Memory Underestimation: mem-underest-vm not running — skipping non-empty assertion"
    fi

    stop_thanos_port_forward

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="$errors dashboard stat/table pair(s) diverged"
        return 1
    fi
    return 0
}

# =============================================================================
# Phase 21b: Stopped VM Exclusion (ACM-41141 regression test)
# Stops a VM and verifies it is excluded from both stat and table queries.
# Validates that running VM filter works end-to-end.
# =============================================================================

phase_21b() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi
    if [[ "$SKIP_VM" == "true" ]]; then
        PHASE_SKIP_REASON="--skip-vm"
        return 2
    fi

    switch_context "$HUB_CONTEXT" || { PHASE_FAIL_REASON="Cannot switch to hub context"; return 1; }

    if ! $KUBE_CLI --context="$VM_SPOKE_CONTEXT" get namespace "$RS_VM_WORKLOAD_NS" &>/dev/null 2>&1; then
        PHASE_FAIL_REASON="VM namespace $RS_VM_WORKLOAD_NS not found on $VM_SPOKE_CONTEXT — run phase 18 first"
        return 1
    fi

    # Not declared local — must be visible to restart_test_vm trap handler
    test_vm="fedora-vm-2"
    if ! $KUBE_CLI --context="$VM_SPOKE_CONTEXT" get vm "$test_vm" -n "$RS_VM_WORKLOAD_NS" &>/dev/null 2>&1; then
        PHASE_FAIL_REASON="VM $test_vm not found on $VM_SPOKE_CONTEXT — run phase 18 first"
        return 1
    fi

    if ! vm_is_running "$VM_SPOKE_CONTEXT" "$RS_VM_WORKLOAD_NS" "$test_vm"; then
        PHASE_FAIL_REASON="VM $test_vm is not running — cannot test stop/exclusion cycle"
        return 1
    fi

    if [[ -z "${THANOS_URL:-}" ]]; then
        log_substep "Discovering Thanos endpoint"
        if ! discover_thanos_endpoint; then
            PHASE_FAIL_REASON="No Thanos endpoint found on hub"
            return 1
        fi
    fi
    THANOS_TOKEN=$($KUBE_CLI whoami -t 2>/dev/null || echo "")

    local errors=0

    # Cleanup trap: always restart the VM on exit from this function
    # Not declared local — nested functions called via trap RETURN don't inherit locals
    vm_stopped=false
    restart_test_vm() {
        trap - RETURN  # clear trap — bash RETURN traps persist after first fire
        if [[ "$vm_stopped" == "true" ]]; then
            vm_stopped=false  # prevent double-execution on any stray RETURN
            log_substep "Cleanup: restarting $test_vm"
            $KUBE_CLI --context="$VM_SPOKE_CONTEXT" patch vm "$test_vm" -n "$RS_VM_WORKLOAD_NS" \
                --type=merge -p '{"spec":{"running":true}}' &>/dev/null || true
            wait_until "$TIMEOUT_VM_BOOT" 10 "$test_vm running" \
                vm_is_running "$VM_SPOKE_CONTEXT" "$RS_VM_WORKLOAD_NS" "$test_vm" || \
                log_warn "  $test_vm did not reach Running in ${TIMEOUT_VM_BOOT}s"
        fi
    }
    trap restart_test_vm RETURN

    # Step 1: Stop the VM
    log_substep "Stopping VM $test_vm"
    $KUBE_CLI --context="$VM_SPOKE_CONTEXT" patch vm "$test_vm" -n "$RS_VM_WORKLOAD_NS" \
        --type=merge -p '{"spec":{"running":false}}' &>/dev/null
    vm_stopped=true

    # Step 2: Wait for VM to leave Running state
    local elapsed=0
    while [[ $elapsed -lt 120 ]]; do
        if ! vm_is_running "$VM_SPOKE_CONTEXT" "$RS_VM_WORKLOAD_NS" "$test_vm"; then
            break
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    if vm_is_running "$VM_SPOKE_CONTEXT" "$RS_VM_WORKLOAD_NS" "$test_vm"; then
        log_warn "  $test_vm did not leave Running in 120s, continuing anyway"
    else
        log_success "  $test_vm: Stopped"
    fi

    # Step 3: Wait for spoke Prometheus to reflect stopped state
    if [[ -z "${SPOKE_THANOS_HOST:-}" ]]; then
        spoke_discover_thanos "$VM_SPOKE_CONTEXT" || true
    fi
    if [[ -n "${SPOKE_THANOS_HOST:-}" ]]; then
        log_substep "Waiting for spoke running_status metric to clear for $test_vm"
        local spoke_cleared=false
        local attempt=0
        while [[ $attempt -lt 8 ]]; do
            local val
            val=$(spoke_query_metric "kubevirt_vm_running_status_last_transition_timestamp_seconds" \
                "name=\"$test_vm\",namespace=\"$RS_VM_WORKLOAD_NS\"")
            if [[ -z "$val" || "$val" == "0" ]]; then
                spoke_cleared=true
                break
            fi
            ((attempt++)) || true
            sleep 15
        done
        if [[ "$spoke_cleared" == "true" ]]; then
            log_success "  Spoke: running_status cleared for $test_vm"
        else
            log_warn "  Spoke: running_status not cleared after 120s, relying on hub Thanos wait"
        fi
    else
        log_warn "  Spoke Prometheus unreachable, relying on hub Thanos wait"
    fi

    # Step 4: Wait for hub Thanos to reflect stopped state
    log_substep "Waiting for hub Thanos running_status to clear for $test_vm (up to ${TIMEOUT_HUB_METRIC_PROPAGATION}s)"
    local hub_cleared=false
    local attempt=0
    local max_attempts=$(( TIMEOUT_HUB_METRIC_PROPAGATION / 30 ))
    while [[ $attempt -lt $max_attempts ]]; do
        local val
        val=$(thanos_query_promql "max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster=\"$VM_SPOKE_CONTEXT\", namespace=\"$RS_VM_WORKLOAD_NS\", name=\"$test_vm\"} > 0) > 0")
        if [[ -z "$val" ]]; then
            hub_cleared=true
            break
        fi
        ((attempt++)) || true
        sleep 30
    done
    if [[ "$hub_cleared" != "true" ]]; then
        PHASE_FAIL_REASON="Hub Thanos still shows $test_vm as running after ${TIMEOUT_HUB_METRIC_PROPAGATION}s — federation lag exceeded timeout"
        return 1
    fi
    log_success "  Hub Thanos: running_status cleared for $test_vm"

    # Step 5: Exclusion check — stopped VM should not appear in overestimation table
    log_substep "Exclusion check: verifying $test_vm is absent from memory overestimation query"
    local cluster="$VM_SPOKE_CONTEXT"
    local profile="Max OverAll"
    local namespace="$RS_VM_WORKLOAD_NS"
    local days="1d"

    local excl_query
    excl_query=$(subst_dashboard_vars \
        '(floor((max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_request{cluster="$cluster", profile="$profile", namespace=~"$namespace", name="'"$test_vm"'"})[$days:]) / 1073741824)-(max_over_time(sum by (name, namespace) (acm_rs_vm:namespace:memory_recommendation{cluster="$cluster", profile="$profile", namespace=~"$namespace", name="'"$test_vm"'"})[$days:]) / 1073741824)) > 0) and on (name, namespace) (max by (name, namespace) (kubevirt_vm_running_status_last_transition_timestamp_seconds{cluster="$cluster", namespace=~"$namespace"} > 0) > 0)' \
        "$cluster" "$profile" "$namespace" "$days")
    # Retry up to 3x — Thanos multi-replica queries can transiently return stale
    # values on one replica right after another confirms the metric cleared.
    local excl_val excl_attempt=0 excl_excluded=false
    while [[ $excl_attempt -lt 3 ]]; do
        excl_val=$(thanos_query_promql "$excl_query")
        if [[ -z "$excl_val" ]]; then
            excl_excluded=true
            break
        fi
        ((excl_attempt++)) || true
        [[ $excl_attempt -lt 3 ]] && sleep 15
    done
    if [[ "$excl_excluded" == "true" ]]; then
        log_success "  $test_vm: correctly excluded from memory overestimation query (empty result)"
    else
        log_error "  $test_vm: STILL PRESENT in memory overestimation query (value=$excl_val)"
        ((errors++)) || true
    fi

    # Step 6: Consistency check — stat vs table should still match
    log_substep "Consistency check: stat vs table with $test_vm stopped"
    local -a pairs=(
        "CPU Overestimation:STAT_CPU_OVEREST_TMPL:TABLE_CPU_OVEREST_TMPL"
        "CPU Underestimation:STAT_CPU_UNDEREST_TMPL:TABLE_CPU_UNDEREST_TMPL"
        "Memory Overestimation:STAT_MEM_OVEREST_TMPL:TABLE_MEM_OVEREST_TMPL"
        "Memory Underestimation:STAT_MEM_UNDEREST_TMPL:TABLE_MEM_UNDEREST_TMPL"
    )

    for entry in "${pairs[@]}"; do
        IFS=: read -r label stat_tmpl_name table_tmpl_name <<< "$entry"

        local stat_query table_query
        stat_query=$(subst_dashboard_vars "${!stat_tmpl_name}" "$cluster" "$profile" "$namespace" "$days")
        table_query=$(subst_dashboard_vars "${!table_tmpl_name}" "$cluster" "$profile" "$namespace" "$days")

        local stat_val table_val
        stat_val=$(thanos_query_promql "$stat_query")
        table_val=$(thanos_query_promql "$table_query")

        assert_stat_table_match "$label" "$stat_val" "$table_val" "$stat_query" "$table_query" || \
            ((errors++)) || true
    done

    stop_thanos_port_forward

    if [[ $errors -gt 0 ]]; then
        PHASE_FAIL_REASON="$errors check(s) failed with stopped VM"
        return 1
    fi
    return 0
}

phase_22() {
    if [[ "$DATA_PLANE" != "true" && -z "$SELECTED_PHASES" ]]; then
        PHASE_SKIP_REASON="Use --data-plane to enable"
        return 2
    fi

    log_substep "Cleaning up data-plane workloads"
    cleanup_data_plane_workloads

    stop_thanos_port_forward
    switch_context "$HUB_CONTEXT" 2>/dev/null || true
    return 0
}

# =============================================================================
# Summary
# =============================================================================

print_summary() {
    echo ""
    print_separator
    echo -e "${BOLD}Right-Sizing E2E Results${NC}"
    print_separator

    local cluster_url
    cluster_url=$($KUBE_CLI cluster-info 2>/dev/null | head -1 | awk '{print $NF}' || echo "unknown")
    local mc_count
    mc_count=$($KUBE_CLI get managedcluster --no-headers 2>/dev/null | wc -l | tr -d ' ' || echo "0")
    local mc_details=""
    if [[ "$mc_count" -gt 0 ]]; then
        mc_details=$($KUBE_CLI get managedcluster \
            -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.labels.openshiftVersion}{"\t"}{.status.conditions[?(@.type=="ManagedClusterConditionAvailable")].status}{"\t"}{.spec.managedClusterClientConfigs[0].url}{"\n"}{end}' \
            2>/dev/null || echo "")
    fi
    local acm_version
    acm_version=$($KUBE_CLI get mch multiclusterhub -n "$ACM_NAMESPACE" \
        -o jsonpath='{.status.currentVersion}' 2>/dev/null || echo "unknown")
    local mco_image
    mco_image=$($KUBE_CLI get pod -n "$ACM_NAMESPACE" \
        -l name=multicluster-observability-operator \
        -o jsonpath='{.items[0].spec.containers[0].image}' 2>/dev/null || echo "unknown")
    local mcoa_image=""
    # Priority 1: actual running MCOA addon-manager pod on the cluster
    mcoa_image=$($KUBE_CLI get pod -n "$OBS_NAMESPACE" \
        -l app=multicluster-observability-addon-manager \
        -o jsonpath='{.items[0].spec.containers[0].image}' 2>/dev/null || echo "")
    # Priority 2: mch-image-manifest ConfigMap (ACM source of truth)
    if [[ -z "$mcoa_image" ]]; then
        local manifest_cm
        manifest_cm=$($KUBE_CLI get configmap -n "$ACM_NAMESPACE" --no-headers 2>/dev/null | \
            awk '/^mch-image-manifest/{print $1}' | tail -1)
        if [[ -n "$manifest_cm" ]]; then
            mcoa_image=$($KUBE_CLI get configmap "$manifest_cm" -n "$ACM_NAMESPACE" \
                -o jsonpath='{.data.multicluster_observability_addon}' 2>/dev/null || echo "")
        fi
    fi
    mcoa_image="${mcoa_image:-unknown}"

    local coo_version="$CAPTURED_COO_VERSION"
    local perses_image="$CAPTURED_PERSES_IMAGE"

    echo -e "  Hub Cluster:      $cluster_url"
    echo -e "  ACM Version:      $acm_version"
    if [[ -n "$coo_version" ]]; then
        echo -e "  COO Version:      $coo_version"
    fi
    echo -e "  Managed Clusters: $mc_count"
    if [[ -n "$mc_details" ]]; then
        while IFS=$'\t' read -r mc_name mc_ocp mc_avail mc_url; do
            if [[ -z "$mc_name" ]]; then continue; fi
            local status_str="Available"
            if [[ "$mc_avail" != "True" ]]; then status_str="Unavailable"; fi
            local ocp_str=""
            if [[ -n "$mc_ocp" ]]; then ocp_str="OCP $mc_ocp"; fi
            if [[ "$mc_name" == "local-cluster" ]]; then
                printf "    %-20s %-14s %s\n" "$mc_name" "$status_str" "$ocp_str"
            else
                printf "    %-20s %-14s %-12s %s\n" "$mc_name" "$status_str" "$ocp_str" "${mc_url:-}"
            fi
        done <<< "$mc_details"
    fi
    echo -e "  MCO Image:        $mco_image"
    echo -e "  MCOA Image:       $mcoa_image"
    if [[ -n "$perses_image" ]]; then
        echo -e "  Perses Image:     $perses_image"
    fi
    echo ""

    printf "  ${BOLD}%-6s %-42s %-8s %-8s %s${NC}\n" "ID" "Test" "Result" "Time" "Notes"
    printf "  %-6s %-42s %-8s %-8s %s\n" "----" "----" "------" "----" "-----"

    for i in "${!RESULT_IDS[@]}"; do
        local id="${RESULT_IDS[$i]}"
        local name="${RESULT_NAMES[$i]}"
        local status="${RESULT_STATUSES[$i]}"
        local notes="${RESULT_NOTES[$i]}"
        local duration="${RESULT_DURATIONS[$i]}"

        local color="$NC"
        case "$status" in
            PASS) color="$GREEN" ;;
            FAIL) color="$RED" ;;
            SKIP) color="$YELLOW" ;;
        esac

        local dur_str=""
        if [[ "$status" != "SKIP" || "$duration" -gt 0 ]]; then
            dur_str=$(format_duration "$duration")
        fi

        printf "  %-6s %-42s ${color}%-8s${NC} %-8s %s\n" \
            "$id" "$name" "$status" "$dur_str" "$notes"
    done

    local total_duration=$((SECONDS - E2E_START_TIME))
    local total_dur_str
    total_dur_str=$(format_duration "$total_duration")

    echo ""
    print_separator
    echo -e "  ${GREEN}PASS: $TOTAL_PASS${NC}  ${RED}FAIL: $TOTAL_FAIL${NC}  ${YELLOW}SKIP: $TOTAL_SKIP${NC}  Total: $total_dur_str"
    print_separator

    if [[ $TOTAL_FAIL -gt 0 ]]; then
        echo ""
        log_warn "Some tests failed. Run 'bin/rs-status' for current state."
    fi

    local uninstall_ran=false
    for i in "${!RESULT_IDS[@]}"; do
        if [[ "${RESULT_IDS[$i]}" =~ ^1[345] ]]; then
            if [[ "${RESULT_STATUSES[$i]}" == "PASS" ]]; then
                uninstall_ran=true
            fi
        fi
    done
    if [[ "$uninstall_ran" == "true" ]]; then
        if ! resource_exists mco "$MCO_NAME" 2>/dev/null; then
            echo ""
            log_info "MCO was deleted during tests. Reinstall with:"
            log_info "  bin/setup-observability install"
        fi
    fi
}

# =============================================================================
# Main
# =============================================================================

main() {
    parse_args "$@"

    E2E_START_TIME=$SECONDS

    init_acm_tools
    init_hub_context
    detect_release
    apply_release_phase_defaults

    echo ""
    log_step "Right-Sizing E2E Validation"
    print_separator
    log_info "Release: $RS_RELEASE"
    if [[ -n "$SELECTED_PHASES" ]]; then
        log_info "Selected phases: $SELECTED_PHASES"
    else
        log_info "Running all phases"
    fi
    if [[ -n "$FORCE_MODE" ]]; then
        log_info "Forced mode: $FORCE_MODE"
    fi

    if [[ -n "$BUILD_TARGET" ]]; then
        prephase_build || { log_error "Build pre-phase failed"; exit 1; }
    elif [[ "$IMAGE_OVERRIDE_ONLY" == "true" ]]; then
        prephase_image_override || { log_error "Image override failed"; exit 1; }
    fi

    # Phase order optimized to minimize mode switches:
    #   Group 1: MCO-mode tests (no switches from baseline)
    #   Group 2: MCO->MCOA transition + MCOA-mode tests (1 switch)
    #   Group 3: MCOA->MCO round-trip tests (3 switches)
    #   Group 4: Destructive tests — MCO deletion/reinstall (last)
    run_phase "0"   "Pre-flight checks"              phase_0
    run_phase "0a"  "Auto-migration (legacy Policy cleanup)" phase_0a
    run_phase "1"   "Baseline resource verification"  phase_1
    run_phase "2a"  "Disable namespace RS only"       phase_2a
    run_phase "2b"  "Swap features (ns on, virt off)" phase_2b
    run_phase "2c"  "Disable both features"           phase_2c
    run_phase "2d"  "Re-enable both features"         phase_2d
    run_phase "2e"  "NamespaceBinding change (MCO)"   phase_2e
    run_phase "3"   "Spoke validation"                phase_3
    run_phase "4"   "ConfigMap propagation (MCO)"     phase_4
    run_phase "4a"  "ConfigMap coexistence (MCO+MCOA)" phase_4a
    run_phase "5"   "MCO -> MCOA switch"              phase_5
    run_phase "6"   "SpecHash freshness"              phase_6
    run_phase "7"   "ConfigMap predicate side-effect"  phase_7
    run_phase "8"   "Placement filter"                phase_8
    run_phase "9a"  "Disable namespace RS (MCOA)"     phase_9a
    run_phase "9b"  "Swap features (MCOA)"            phase_9b
    run_phase "9c"  "Disable both (MCOA)"             phase_9c
    run_phase "9d"  "Re-enable both (MCOA)"           phase_9d
    run_phase "9e"  "NamespaceBinding change (MCOA)"  phase_9e
    run_phase "10"  "ConfigMap propagation (MCOA)"    phase_10
    run_phase "11"  "MCOA -> MCO switch"              phase_11
    run_phase "12"  "Version mismatch"                phase_12

    # Group 5: Data-plane validation (--data-plane)
    # Runs before destructive phases so MCO is still active
    run_phase "17"  "Deploy namespace workloads"      phase_17
    run_phase "18"  "Deploy VM workloads"             phase_18
    run_phase "19"  "Metrics collection wait"         phase_19
    run_phase "20"  "Namespace metrics validation"    phase_20
    run_phase "21"  "VM metrics validation"           phase_21
    run_phase "21a" "VM dashboard query consistency"  phase_21a
    run_phase "21b" "Stopped VM exclusion"            phase_21b
    run_phase "22"  "Data-plane cleanup"              phase_22

    # Group 4: Destructive tests (last — MCO deletion/reinstall)
    run_phase "13"  "Uninstall cleanup (MCO mode)"    phase_13
    run_phase "14"  "Uninstall cleanup (MCOA mode)"   phase_14
    run_phase "15"  "MCOA uninstall + reinstall"      phase_15
    run_phase "16"  "Mode switch after reinstall"     phase_16

    print_summary

    [[ $TOTAL_FAIL -eq 0 ]]
}

main "$@"
