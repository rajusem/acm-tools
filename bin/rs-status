#!/bin/bash
# =============================================================================
# rs-status — Quick right-sizing diagnostic dashboard
# =============================================================================
#
# Usage:
#   rs-status                 # Show full status
#   rs-status --hub-only      # Skip spoke checks
#   rs-status --spoke NAME    # Check specific spoke
#   rs-status --watch         # Refresh every 10s
#
# Shows a one-screen color-coded overview of right-sizing state across
# hub and spoke clusters.
# =============================================================================

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"

usage() {
    echo "Usage: $(basename "$0") [options]"
    echo ""
    echo "Options:"
    echo "  --hub-only     Skip spoke cluster checks"
    echo "  --spoke NAME   Spoke context to check (default: $NAMESPACE_SPOKE_CONTEXT)"
    echo "  --watch        Refresh every 10 seconds (Ctrl+C to stop)"
    echo "  --json         Output as JSON (for scripting)"
}

HUB_ONLY=false
SPOKE="$NAMESPACE_SPOKE_CONTEXT"
SPOKE_FILTER_SET=false
WATCH_MODE=false
JSON_MODE=false
STATUS_MANIFESTWORKS_READY=false
STATUS_RENDERED_INTERVALS=""

# Read a right-sizing ConfigMap's prometheusRuleConfig as one compact JSON object.
# Args: ConfigMap name (in OBS_NAMESPACE).
# Stdout: the JSON object ({} when the key is unset) or, on failure, a short reason.
# Returns: 0 ok; 1 the ConfigMap or its blob could not be read.
status_config_json() {
    local cm="$1" blob
    if ! blob=$(rs_rule_config_from_cluster "$cm" "$OBS_NAMESPACE" 2>/dev/null); then
        echo "ConfigMap read failed"
        return 1
    fi
    rs_rule_config_to_json "$blob" 2>/dev/null && return 0
    if rs_have_yq; then
        echo "not a single YAML/JSON object"
    else
        echo "YAML needs yq v4 (brew install yq)"
    fi
    return 1
}

# Collect the rendered right-sizing rule-group intervals from every MCOA
# ManifestWork, once per refresh. Call it in the parent shell before any
# $(status_rendered_interval ...): a load inside $(...) is lost on return.
# Globals: sets STATUS_RENDERED_INTERVALS ("slot<TAB>interval" lines; slots are
#   namespace_rolling, namespace_daily, virtualization_rolling and
#   virtualization_daily) and STATUS_MANIFESTWORKS_READY=true.
status_load_manifestworks() {
    [[ "$STATUS_MANIFESTWORKS_READY" == "true" ]] && return 0
    STATUS_RENDERED_INTERVALS=""
    local mc_list mc mws_json values
    mc_list=$($KUBE_CLI get managedcluster -o jsonpath='{.items[*].metadata.name}' \
        --request-timeout=10s 2>/dev/null || echo "")
    for mc in $mc_list; do
        mws_json=$($KUBE_CLI get manifestwork -n "$mc" -o json --request-timeout=10s 2>/dev/null || echo "")
        jq -e . >/dev/null 2>&1 <<< "$mws_json" || continue
        # Rolling groups end in -5m.rule; daily groups end in -1d.rule or
        # -1d.rules (acm-right-sizing-namespace-1d.rules).
        values=$(jq -r --arg pattern "$MCOA_MW_PATTERN" '
            .items[]? | select(.metadata.name | test($pattern)) |
            .spec.workload.manifests[]? | select(.kind == "PrometheusRule") |
            .metadata.name as $rule | .spec.groups[]? | select(.interval | type == "string") |
            (if $rule == "acm-rs-namespace-prometheus-rules" then "namespace"
             elif $rule == "acm-rs-virt-prometheus-rules" then "virtualization"
             else empty end) as $owner |
            (if (.name | test("-5m\\.rule$")) then "rolling"
             elif (.name | test("-1d\\.rules?$")) then "daily"
             else empty end) as $kind |
            [$owner + "_" + $kind, .interval] | @tsv
        ' <<< "$mws_json" 2>/dev/null || true)
        [[ -n "$values" ]] && STATUS_RENDERED_INTERVALS+="$values"$'\n'
    done
    STATUS_MANIFESTWORKS_READY=true
}

# Collapse interval values into one value, or mixed(a,b) when they disagree.
# Args: newline-separated intervals. Equal durations in different units
#   (300s and 5m) count as the same value.
# Stdout: the first value, or mixed(first,other).
# Returns: 0 printed; 1 no values.
status_interval_summary() {
    local values="$1" first="" first_ms="" value value_ms
    while IFS= read -r value; do
        [[ -n "$value" ]] || continue
        value_ms=$(rs_duration_ms "$value" 2>/dev/null || true)
        if [[ -z "$first" ]]; then
            first="$value"
            first_ms="$value_ms"
        elif [[ "$value" != "$first" && ( -z "$first_ms" || -z "$value_ms" || "$value_ms" != "$first_ms" ) ]]; then
            printf 'mixed(%s,%s)\n' "$first" "$value"
            return 0
        fi
    done <<< "$values"
    [[ -n "$first" ]] || return 1
    printf '%s\n' "$first"
}

# Summarize the rendered interval of one ConfigMap's rolling or daily groups
# across all MCOA ManifestWorks.
# Args: ConfigMap name (rs-namespace-config|rs-virt-config), kind (rolling|daily).
# Stdout: see status_interval_summary. Loads the ManifestWork cache if needed.
# Returns: 0 printed; 1 unknown arguments or no rendered group.
status_rendered_interval() {
    local cm="$1" kind="$2" slot cached_slot cached_value values=""
    case "$cm:$kind" in
        rs-namespace-config:rolling) slot="namespace_rolling" ;;
        rs-namespace-config:daily) slot="namespace_daily" ;;
        rs-virt-config:rolling) slot="virtualization_rolling" ;;
        rs-virt-config:daily) slot="virtualization_daily" ;;
        *) return 1 ;;
    esac
    status_load_manifestworks
    while IFS=$'\t' read -r cached_slot cached_value; do
        [[ "$cached_slot" == "$slot" ]] || continue
        values+="${values:+$'\n'}$cached_value"
    done <<< "$STATUS_RENDERED_INTERVALS"
    status_interval_summary "$values"
}

# Build the rs_config JSON for one ConfigMap: configured intervals, their
# source, and the rendered intervals.
# Args: ConfigMap name.
# Stdout: a JSON object. source is default, custom, mixed or unreadable; error
#   holds the reason when the configuration could not be read, else null.
status_rs_config_json() {
    local cm="$1" config_json value="" value_1d="" rendered rendered_1d source error=""
    if config_json=$(status_config_json "$cm"); then
        value=$(rs_rule_config_get "$config_json" evaluationInterval || true)
        value_1d=$(rs_rule_config_get "$config_json" evaluationInterval1d || true)
        source="mixed"
        [[ -z "$value" && -z "$value_1d" ]] && source="default"
        [[ -n "$value" && -n "$value_1d" ]] && source="custom"
    else
        source="unreadable"
        error="$config_json"
    fi
    rendered=$(status_rendered_interval "$cm" rolling 2>/dev/null || true)
    rendered_1d=$(status_rendered_interval "$cm" daily 2>/dev/null || true)
    jq -n --arg value "$value" --arg value1d "$value_1d" \
        --arg source "$source" --arg error "$error" \
        --arg rendered "$rendered" --arg rendered1d "$rendered_1d" '{
          evaluation_interval: (if $value == "" then null else $value end),
          evaluation_interval_1d: (if $value1d == "" then null else $value1d end),
          source: $source,
          error: (if $error == "" then null else $error end),
          rendered: {evaluation_interval: (if $rendered == "" then null else $rendered end), evaluation_interval_1d: (if $rendered1d == "" then null else $rendered1d end)}
        }'
}

# Print one interval line of the text dashboard: the value (or its default),
# validation state, and rendered value with drift detection.
# Args: ConfigMap, label, configured value (empty = default), default,
#   minimum, maximum, rendered value (empty = not rendered).
# Stdout: one colored line.
status_print_interval() {
    local cm="$1" label="$2" value="$3" default="$4" min="$5" max="$6" rendered="$7" rc color suffix
    local shown="${value:-$default}"
    suffix=""
    [[ -z "$value" ]] && suffix=" (default)"
    if rs_eval_interval_check "$value" "$min" "$max"; then
        color="$GREEN"
    else
        rc=$?
        color="$RED"
        if [[ "$rc" -eq 2 ]]; then
            suffix=" (invalid: allowed $min to $max; MCOA will revert)"
        else
            suffix=" (invalid: expected a single duration $min to $max; MCOA will revert)"
        fi
    fi
    if [[ -n "$rendered" ]]; then
        if rs_eval_interval_check "$value" "$min" "$max" && \
            [[ "$(rs_duration_ms "${value:-$default}")" == "$(rs_duration_ms "$rendered")" ]]; then
            suffix="$suffix rendered=$rendered"
        else
            suffix="$suffix rendered=$rendered (DRIFT)"
            color="$RED"
        fi
    fi
    echo -e "      ${color}${label}=${shown}${suffix}${NC}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --hub-only) HUB_ONLY=true; shift ;;
        --spoke)    SPOKE="$2"; SPOKE_FILTER_SET=true; shift 2 ;;
        --watch)    WATCH_MODE=true; shift ;;
        --json)     JSON_MODE=true; shift ;;
        --release)
            [[ -z "${2:-}" ]] && { log_error "--release requires 2.16, 2.17, or 5.0"; exit 1; }
            RS_RELEASE="${2}"
            [[ "$RS_RELEASE" =~ ^(2\.16|2\.17|5\.0)$ ]] || { log_error "--release must be 2.16, 2.17, or 5.0"; exit 1; }
            shift 2 ;;
        -h|--help)  usage; exit 0 ;;
        *) log_error "Unknown option: $1"; usage; exit 1 ;;
    esac
done

# Print the right-sizing dashboard: mode, MCO CR flags, AddOnDeploymentConfig,
# RS ConfigMaps with their configured and rendered intervals, mode-specific
# resources, spoke PrometheusRules (unless --hub-only), operator pods,
# COO/Perses and images. With --json, prints show_status_json instead.
# Each call is one --watch refresh.
# Globals: resets STATUS_MANIFESTWORKS_READY and STATUS_RENDERED_INTERVALS;
#   caches RS_YQ_V4 (rs_have_yq) for the helpers below.
# Stdout: the dashboard. Reads the cluster only.
show_status() {
    # Reset the ManifestWork cache so every --watch refresh rescans, and probe
    # yq once here so the $(...) helpers below inherit the cached answer.
    STATUS_MANIFESTWORKS_READY=false
    STATUS_RENDERED_INTERVALS=""
    rs_have_yq || true
    if [[ "$JSON_MODE" == "true" ]]; then
        show_status_json
        return
    fi

    print_separator
    echo -e "${BOLD}Right-Sizing Status Dashboard${NC}"
    print_separator
    echo ""

    if ! resource_exists mco "$MCO_NAME"; then
        log_warn "MCO CR '$MCO_NAME' not found. Set up observability first:"
        log_info "  bin/setup-observability"
        return 0
    fi

    # ── Mode ──
    local annotation=""
    annotation=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath="{.metadata.annotations.${RS_ANNOTATION//./\\.}}" 2>/dev/null || echo "")

    local mcoa_active=false
    if   release_is_50;                               then mcoa_active=true
    elif release_is_217 && [[ -n "$annotation" ]];    then mcoa_active=true
    fi

    local mode mode_color
    if [[ "$mcoa_active" == "true" ]]; then
        mode="MCOA (ManifestWork-based)"; mode_color="$GREEN"
    else
        mode="MCO (Policy-based)"; mode_color="$BLUE"
    fi
    echo -e "  Mode:    ${mode_color}${BOLD}$mode${NC}"
    echo -e "  Release: ACM $RS_RELEASE"
    if release_is_217; then
        echo -e "  MCO CR:  annotation=${annotation:-<not set>}"
    fi

    # ── MCO CR ──
    echo ""
    echo -e "${BOLD}  MCO CR (spec.capabilities.platform.analytics):${NC}"
    local ns_enabled virt_enabled
    ns_enabled=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath='{.spec.capabilities.platform.analytics.namespaceRightSizingRecommendation.enabled}' 2>/dev/null || echo "?")
    virt_enabled=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath='{.spec.capabilities.platform.analytics.virtualizationRightSizingRecommendation.enabled}' 2>/dev/null || echo "?")

    local ns_icon="$RED" virt_icon="$RED"
    [[ "$ns_enabled" == "true" ]] && ns_icon="$GREEN"
    [[ "$virt_enabled" == "true" ]] && virt_icon="$GREEN"
    echo -e "    ${ns_icon}Namespace:       $ns_enabled${NC}"
    echo -e "    ${virt_icon}Virtualization:  $virt_enabled${NC}"

    local ns_binding virt_binding
    ns_binding=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath='{.spec.capabilities.platform.analytics.namespaceRightSizingRecommendation.namespaceBinding}' 2>/dev/null || echo "")
    virt_binding=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath='{.spec.capabilities.platform.analytics.virtualizationRightSizingRecommendation.namespaceBinding}' 2>/dev/null || echo "")
    echo -e "    NS Binding:      ${ns_binding:-(default: $GLOBAL_SET_NAMESPACE)}"
    echo -e "    Virt Binding:    ${virt_binding:-(default: $GLOBAL_SET_NAMESPACE)}"

    # ── ADC (MCOA mode only) ──
    echo ""
    if [[ "$mcoa_active" == "true" ]]; then
        echo -e "${BOLD}  AddOnDeploymentConfig:${NC}"
        local adc_json
        adc_json=$($KUBE_CLI get addondeploymentconfig "$MCOA_NAME" \
            -n "$OBS_NAMESPACE" -o json 2>/dev/null || echo "{}")

        local ns_adc virt_adc
        ns_adc=$(echo "$adc_json" | jq -r '.spec.customizedVariables[]? | select(.name=="platformNamespaceRightSizing") | .value' 2>/dev/null)
        virt_adc=$(echo "$adc_json" | jq -r '.spec.customizedVariables[]? | select(.name=="platformVirtualizationRightSizing") | .value' 2>/dev/null)

        local ns_adc_icon="$YELLOW" virt_adc_icon="$YELLOW"
        [[ "$ns_adc" == "enabled" ]] && ns_adc_icon="$GREEN"
        [[ "$ns_adc" == "disabled" ]] && ns_adc_icon="$RED"
        [[ "$virt_adc" == "enabled" ]] && virt_adc_icon="$GREEN"
        [[ "$virt_adc" == "disabled" ]] && virt_adc_icon="$RED"
        echo -e "    ${ns_adc_icon}platformNamespaceRightSizing:      ${ns_adc:-not set (auto-enables)}${NC}"
        echo -e "    ${virt_adc_icon}platformVirtualizationRightSizing: ${virt_adc:-not set (auto-enables)}${NC}"
    else
        echo -e "${BOLD}  AddOnDeploymentConfig:${NC} ${BLUE}N/A (MCO mode)${NC}"
    fi

    # ── ConfigMaps ──
    echo ""
    echo -e "${BOLD}  ConfigMaps (${OBS_NAMESPACE}):${NC}"
    status_load_manifestworks
    for cm in rs-namespace-config rs-virt-config; do
        if resource_exists configmap "$cm" "$OBS_NAMESPACE"; then
            echo -e "    ${GREEN}$cm: exists${NC}"
            local cm_json cm_eval cm_eval_1d rendered rendered_1d
            rendered=$(status_rendered_interval "$cm" rolling 2>/dev/null || true)
            rendered_1d=$(status_rendered_interval "$cm" daily 2>/dev/null || true)
            if ! cm_json=$(status_config_json "$cm"); then
                echo -e "      ${RED}prometheusRuleConfig unreadable: ${cm_json}${NC}"
                echo -e "      rendered: evaluationInterval=${rendered:-none} evaluationInterval1d=${rendered_1d:-none}"
                continue
            fi
            cm_eval=$(rs_rule_config_get "$cm_json" evaluationInterval || true)
            cm_eval_1d=$(rs_rule_config_get "$cm_json" evaluationInterval1d || true)
            status_print_interval "$cm" "evaluationInterval" "$cm_eval" "$RS_EVAL_INTERVAL_DEFAULT" \
                "$RS_EVAL_INTERVAL_MIN" "$RS_EVAL_INTERVAL_MAX" "$rendered"
            status_print_interval "$cm" "evaluationInterval1d" "$cm_eval_1d" "$RS_EVAL_INTERVAL_1D_DEFAULT" \
                "$RS_EVAL_INTERVAL_1D_MIN" "$RS_EVAL_INTERVAL_1D_MAX" "$rendered_1d"
            if [[ -n "$cm_eval" && -n "$cm_eval_1d" ]] && \
                rs_eval_interval_check "$cm_eval" "$RS_EVAL_INTERVAL_MIN" "$RS_EVAL_INTERVAL_MAX" && \
                rs_eval_interval_check "$cm_eval_1d" "$RS_EVAL_INTERVAL_1D_MIN" "$RS_EVAL_INTERVAL_1D_MAX"; then
                if (( $(rs_duration_ms "$cm_eval") > $(rs_duration_ms "$cm_eval_1d") )); then
                    echo -e "      ${YELLOW}warning: evaluationInterval is coarser than evaluationInterval1d${NC}"
                fi
            fi
        else
            echo -e "    ${RED}$cm: not found${NC}"
        fi
    done

    # ── Mode-specific resources ──
    echo ""
    if [[ "$mcoa_active" == "true" ]]; then
        # MCOA mode
        echo -e "${BOLD}  MCOA Resources:${NC}"

        # MCOA uses in-memory predicate evaluation (no Placement CRs)
        echo -e "    ${GREEN}Cluster selection: in-memory predicate evaluation${NC}"

        # MCA specHash (required for MCOA addon framework to create ManifestWorks)
        echo ""
        echo -e "${BOLD}  ManagedClusterAddon specHash:${NC}"
        local any_empty_hash=false
        for spoke_name in $($KUBE_CLI get managedcluster -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do
            local spec_hash
            spec_hash=$($KUBE_CLI get managedclusteraddon "$MCOA_NAME" -n "$spoke_name" \
                -o jsonpath='{.status.configReferences[0].desiredConfig.specHash}' 2>/dev/null || echo "")
            if [[ -n "$spec_hash" ]]; then
                echo -e "    ${GREEN}$spoke_name: $spec_hash${NC}"
            else
                echo -e "    ${RED}$spoke_name: EMPTY (MCOA will not create ManifestWorks)${NC}"
                any_empty_hash=true
            fi
        done
        if [[ "$any_empty_hash" == "true" ]]; then
            echo -e "    ${RED}FIX: MCO operator must populate desiredConfig.specHash on MCA${NC}"
        fi

        # ManifestWorks
        echo ""
        echo -e "${BOLD}  ManifestWork PrometheusRules:${NC}"
        local spoke_list
        spoke_list=$($KUBE_CLI get managedcluster -o jsonpath='{.items[*].metadata.name}' 2>/dev/null)
        for spoke_name in $spoke_list; do
            local pr_names=""
            for mw in $($KUBE_CLI get manifestwork -n "$spoke_name" -o name 2>/dev/null | grep "$MCOA_MW_PATTERN" || true); do
                local names
                names=$($KUBE_CLI get "$mw" -n "$spoke_name" -o json 2>/dev/null | \
                    jq -r '[.spec.workload.manifests[]? | select(.kind=="PrometheusRule") | select(.metadata.name | test("acm-rs")) | .metadata.name] | .[]' 2>/dev/null || true)
                if [[ -n "$names" ]]; then
                    pr_names="${pr_names:+$pr_names$'\n'}$names"
                fi
            done
            if [[ -n "$pr_names" ]]; then
                local pr_count
                pr_count=$(echo "$pr_names" | wc -l | tr -d ' ')
                echo -e "    ${GREEN}$spoke_name: $pr_count PrometheusRule(s)${NC}"
                echo "$pr_names" | while read -r name; do
                    echo -e "      ${GREEN}- $name${NC}"
                done
            else
                echo -e "    ${RED}$spoke_name: 0 PrometheusRules${NC}"
            fi
        done
    else
        # MCO mode
        echo -e "${BOLD}  MCO Policy Resources (${GLOBAL_SET_NAMESPACE}):${NC}"
        for res_type_name in "policy:rs-prom-rules-policy" "policy:rs-virt-prom-rules-policy" "placement:rs-placement" "placement:rs-virt-placement" "placementbinding:rs-policyset-binding" "placementbinding:rs-virt-policyset-binding"; do
            local rtype="${res_type_name%%:*}"
            local rname="${res_type_name##*:}"
            if resource_exists "$rtype" "$rname" "$GLOBAL_SET_NAMESPACE"; then
                echo -e "    ${GREEN}$rtype/$rname: exists${NC}"
            else
                echo -e "    ${RED}$rtype/$rname: not found${NC}"
            fi
        done
    fi

    # ── Spoke PrometheusRules ──
    if [[ "$HUB_ONLY" == "false" ]]; then
        echo ""
        echo -e "${BOLD}  Spoke PrometheusRules:${NC}"

        local mc_list checked_contexts=""
        mc_list=$($KUBE_CLI get managedcluster -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || echo "")
        for mc in $mc_list; do
            local ctx
            ctx=$(mc_to_context "$mc")

            if [[ "$SPOKE_FILTER_SET" == "true" && "$ctx" != "$SPOKE" ]]; then
                continue
            fi
            # Skip if we already checked this context (e.g. vm-spoke defaults to hub)
            if echo "$checked_contexts" | grep -w "$ctx" >/dev/null; then
                continue
            fi
            checked_contexts="$checked_contexts $ctx"

            if switch_context "$ctx" 2>/dev/null; then
                local rules
                rules=$($KUBE_CLI get prometheusrule -n openshift-monitoring --no-headers 2>/dev/null | grep -i "rs-\|acm-rs" || true)
                if [[ -n "$rules" ]]; then
                    echo -e "    ${GREEN}$mc ($ctx):${NC}"
                    echo "$rules" | while read -r line; do
                        local name
                        name=$(echo "$line" | awk '{print $1}')
                        echo -e "      ${GREEN}- $name${NC}"
                    done
                else
                    echo -e "    ${RED}$mc ($ctx): no right-sizing PrometheusRules${NC}"
                fi
            else
                echo -e "    ${RED}$mc ($ctx): could not connect${NC}"
            fi
        done
        if [[ "$SPOKE_FILTER_SET" == "true" && -z "${checked_contexts// }" ]]; then
            echo -e "    ${YELLOW}No managed cluster mapped to spoke context '$SPOKE'${NC}"
        fi
        switch_context "$HUB_CONTEXT" &>/dev/null || log_warn "Failed to restore hub context — subsequent output may be incorrect"
    fi

    # ── Operator Pods ──
    echo ""
    echo -e "${BOLD}  Operator Pods:${NC}"
    local mco_pod_status mco_pod_phase
    mco_pod_status=$($KUBE_CLI get pods -n "$ACM_NAMESPACE" -l name=multicluster-observability-operator --no-headers 2>/dev/null | awk '{printf "%s (%s)", $1, $3}' | head -1)
    mco_pod_phase=$($KUBE_CLI get pods -n "$ACM_NAMESPACE" -l name=multicluster-observability-operator --no-headers 2>/dev/null | awk '{print $3}' | head -1)
    if [[ "$mco_pod_phase" == "Running" ]]; then
        echo -e "    ${GREEN}MCO:  $mco_pod_status${NC}"
    elif [[ -n "$mco_pod_status" ]]; then
        echo -e "    ${RED}MCO:  $mco_pod_status${NC}"
    else
        echo -e "    ${RED}MCO:  not found${NC}"
    fi

    local mcoa_pod_status
    mcoa_pod_status=$($KUBE_CLI get pods -n "$OBS_NAMESPACE" -l app=$MCOA_DEPLOY --no-headers 2>/dev/null | awk '{printf "%s (%s)", $1, $3}' | head -1)

    # Check if MCOA pod state is correct for the current mode
    local mcoa_has_other_caps=false
    local mco_caps
    mco_caps=$($KUBE_CLI get mco "$MCO_NAME" -o json 2>/dev/null || echo "{}")
    # Check if any non-RS MCOA capability is enabled
    for cap_path in \
        '.spec.capabilities.platform.logs.collection.enabled' \
        '.spec.capabilities.platform.metrics.default.enabled' \
        '.spec.capabilities.platform.analytics.incidentDetection.enabled' \
        '.spec.capabilities.userWorkloads.logs.collection.clusterLogForwarder.enabled' \
        '.spec.capabilities.userWorkloads.traces.collection.collector.enabled' \
        '.spec.capabilities.userWorkloads.traces.collection.instrumentation.enabled' \
        '.spec.capabilities.userWorkloads.metrics.default.enabled'; do
        local val
        val=$(echo "$mco_caps" | jq -r "$cap_path // false" 2>/dev/null)
        if [[ "$val" == "true" ]]; then
            mcoa_has_other_caps=true
            break
        fi
    done

    if [[ "$mcoa_active" == "true" ]] || [[ "$mcoa_has_other_caps" == "true" ]]; then
        # MCOA should be running
        if [[ -n "$mcoa_pod_status" ]]; then
            echo -e "    ${GREEN}MCOA: $mcoa_pod_status${NC}"
        else
            echo -e "    ${RED}MCOA: not found (EXPECTED to be running)${NC}"
        fi
    else
        # MCOA should NOT be running (MCO-only mode for right-sizing)
        if [[ -n "$mcoa_pod_status" ]]; then
            echo -e "    ${YELLOW}MCOA: $mcoa_pod_status (unexpected — no MCOA capabilities or delegation active)${NC}"
        else
            echo -e "    ${GREEN}MCOA: not running (correct — MCO mode, no MCOA capabilities)${NC}"
        fi
    fi

    # ── COO + Perses ──
    if [[ "$mcoa_active" == "true" ]]; then
        local coo_ns="openshift-cluster-observability-operator"
        echo ""
        echo -e "${BOLD}  Cluster Observability Operator (COO):${NC}"
        if check_coo_installed; then
            local coo_phase
            coo_phase=$($KUBE_CLI get csv -n openshift-operators --no-headers 2>/dev/null | \
                awk '/^cluster-observability-operator/{print $NF}')
            echo -e "    ${GREEN}COO: installed (${coo_phase:-unknown})${NC}"
        else
            echo -e "    ${RED}COO: not installed (required for Perses dashboards)${NC}"
        fi

        # Perses pod
        local perses_phase
        perses_phase=$($KUBE_CLI get pods -n "$coo_ns" --no-headers 2>/dev/null | awk '/^perses-/{print $3; exit}')
        if [[ "$perses_phase" == "Running" ]]; then
            echo -e "    ${GREEN}Perses pod: Running${NC}"
        elif [[ -n "$perses_phase" ]]; then
            echo -e "    ${YELLOW}Perses pod: $perses_phase${NC}"
        else
            echo -e "    ${RED}Perses pod: not found${NC}"
        fi

        # Perses dashboards
        local dashboard_count
        dashboard_count=$($KUBE_CLI get persesdashboard -n "$ANALYTICS_NAMESPACE" --no-headers 2>/dev/null | grep -c "acm-rs\|acm-rightsizing" || true)
        if [[ "$dashboard_count" -gt 0 ]]; then
            echo -e "    ${GREEN}Perses dashboards: $dashboard_count${NC}"
            $KUBE_CLI get persesdashboard -n "$ANALYTICS_NAMESPACE" --no-headers 2>/dev/null | grep "acm-rs\|acm-rightsizing" | awk -v g="$GREEN" -v nc="$NC" '{print "      - " g $1 nc}'
        else
            echo -e "    ${RED}Perses dashboards: 0${NC}"
        fi

        # UIPlugin
        if $KUBE_CLI get uiplugin monitoring &>/dev/null; then
            echo -e "    ${GREEN}UIPlugin: monitoring${NC}"
        else
            echo -e "    ${RED}UIPlugin: not found${NC}"
        fi
    fi

    # ── Images ──
    echo ""
    echo -e "${BOLD}  Images:${NC}"
    local mco_img mcoa_img
    mco_img=$(get_resource_field deployment multicluster-observability-operator "$ACM_NAMESPACE" '{.spec.template.spec.containers[0].image}' 2>/dev/null || echo "")
    mcoa_img=$(get_resource_field deployment $MCOA_DEPLOY "$OBS_NAMESPACE" '{.spec.template.spec.containers[0].image}' 2>/dev/null || echo "")
    echo "    MCO:  ${mco_img:-not deployed}"
    echo "    MCOA: ${mcoa_img:-not deployed}"

    echo ""
    print_separator
}

# Print the right-sizing state as one JSON object: mode, release, the MCO
# mode annotation, the MCO CR feature flags, the AddOnDeploymentConfig
# variables (MCOA mode) and rs_config for both RS ConfigMaps (null when a
# ConfigMap is missing; see status_rs_config_json).
# Globals: loads STATUS_RENDERED_INTERVALS (status_load_manifestworks).
# Stdout: the JSON object. Reads the cluster only.
show_status_json() {
    local annotation="" ns_enabled virt_enabled ns_adc virt_adc ns_config_json virt_config_json

    annotation=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath="{.metadata.annotations.${RS_ANNOTATION//./\\.}}" 2>/dev/null || echo "")
    ns_enabled=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath='{.spec.capabilities.platform.analytics.namespaceRightSizingRecommendation.enabled}' 2>/dev/null || echo "null")
    virt_enabled=$($KUBE_CLI get mco "$MCO_NAME" \
        -o jsonpath='{.spec.capabilities.platform.analytics.virtualizationRightSizingRecommendation.enabled}' 2>/dev/null || echo "null")

    local mcoa_active=false
    if   release_is_50;                               then mcoa_active=true
    elif release_is_217 && [[ -n "$annotation" ]];    then mcoa_active=true
    fi

    local mode="mco"
    [[ "$mcoa_active" == "true" ]] && mode="mcoa"

    ns_adc="null"; virt_adc="null"
    if [[ "$mcoa_active" == "true" ]]; then
        local adc_json
        adc_json=$($KUBE_CLI get addondeploymentconfig "$MCOA_NAME" -n "$OBS_NAMESPACE" -o json 2>/dev/null || echo "{}")
        ns_adc=$(echo "$adc_json" | jq -r '.spec.customizedVariables[]? | select(.name=="platformNamespaceRightSizing") | .value' 2>/dev/null || echo "null")
        virt_adc=$(echo "$adc_json" | jq -r '.spec.customizedVariables[]? | select(.name=="platformVirtualizationRightSizing") | .value' 2>/dev/null || echo "null")
    fi

    ns_config_json="null"
    virt_config_json="null"
    status_load_manifestworks
    if resource_exists configmap rs-namespace-config "$OBS_NAMESPACE"; then
        ns_config_json=$(status_rs_config_json rs-namespace-config)
    fi
    if resource_exists configmap rs-virt-config "$OBS_NAMESPACE"; then
        virt_config_json=$(status_rs_config_json rs-virt-config)
    fi

    jq -n \
        --arg mode "$mode" \
        --arg release "$RS_RELEASE" \
        --arg annotation "$annotation" \
        --arg ns_enabled "$ns_enabled" \
        --arg virt_enabled "$virt_enabled" \
        --arg ns_adc "${ns_adc:-null}" \
        --arg virt_adc "${virt_adc:-null}" \
        --argjson ns_config "$ns_config_json" \
        --argjson virt_config "$virt_config_json" \
        '{
            mode: $mode,
            release: $release,
            annotation: $annotation,
            mco_cr: {
                namespace_enabled: ($ns_enabled == "true"),
                virtualization_enabled: ($virt_enabled == "true")
            },
            adc: {
                namespace: (if $ns_adc == "null" then null else $ns_adc end),
                virtualization: (if $virt_adc == "null" then null else $virt_adc end)
            },
            rs_config: {
                namespace: $ns_config,
                virtualization: $virt_config
            }
        }'
}

# --- Main ---
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

init_acm_tools
init_hub_context
detect_release

if [[ "$WATCH_MODE" == "true" ]]; then
    while true; do
        clear
        show_status
        echo ""
        echo -e "${BLUE}Refreshing every 10s... (Ctrl+C to stop)${NC}"
        sleep 10
    done
else
    show_status
fi
