#!/bin/bash
# =============================================================================
# setup-observability — Bootstrap MCO on a hub cluster with SeaweedFS storage
# =============================================================================
#
# Usage:
#   setup-observability [options]
#   setup-observability --skip-object-store   # Use existing object storage
#   setup-observability --enable-rightsizing   # Also enable right-sizing
#   setup-observability --status              # Show observability status
#
# Sets up:
#   1. Observability namespace
#   2. Pull secret
#   3. SeaweedFS (optional in-cluster S3 object storage)
#   4. Thanos object storage secret
#   5. MultiClusterObservability CR
# =============================================================================

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"

MANIFESTS_DIR="$SCRIPT_DIR/../manifests"

usage() {
    echo "Usage: $(basename "$0") [command] [options]"
    echo ""
    echo "Commands:"
    echo "  install     Install observability (default)"
    echo "  uninstall   Remove MCO CR (keeps namespace and storage)"
    echo "  status      Show observability installation status"
    echo ""
    echo "Options (for install):"
    echo "  --skip-object-store     Don't install SeaweedFS (use existing object storage)"
    echo "                          (--skip-minio is kept as an alias)"
    echo "  --enable-rightsizing    Enable right-sizing after setup"
    echo "  --mcoa-mode             Also set MCOA right-sizing annotation"
    echo "  --force-cleanup-mw      Remove finalizers from stuck MCOA ManifestWorks (local-cluster)"
    echo "  --wait-timeout N        Wait timeout in seconds (default: 300)"
    echo ""
    echo "Note: SeaweedFS uses dev-only credentials and ephemeral storage. Do not use on shared clusters."
}

create_manifests_if_missing() {
    mkdir -p "$MANIFESTS_DIR"

    # Namespace
    if [[ ! -f "$MANIFESTS_DIR/namespace.yaml" ]]; then
        cat > "$MANIFESTS_DIR/namespace.yaml" <<'EOF'
apiVersion: v1
kind: Namespace
metadata:
  name: open-cluster-management-observability
EOF
    fi

    # SeaweedFS Deployment (dev-only credentials — do not use on shared clusters).
    # Mirrors dev-scripts/manifests/storage/seaweedfs-deployment.yaml in the MCO
    # repo, which replaced MinIO (quay.io/minio/minio:latest is no longer available).
    # emptyDir: data is lost on pod restart, same as the previous MinIO setup.
    if [[ ! -f "$MANIFESTS_DIR/seaweedfs-deployment.yaml" ]]; then
        cat > "$MANIFESTS_DIR/seaweedfs-deployment.yaml" <<'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: seaweedfs
  namespace: open-cluster-management-observability
  labels:
    app.kubernetes.io/name: seaweedfs
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: seaweedfs
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app.kubernetes.io/name: seaweedfs
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: seaweedfs
          # Override args (not command) so the image entrypoint still dispatches
          # to `mini`; WebDAV and Iceberg listeners are not needed.
          args:
            - mini
            - -dir=/data
            - -webdav=false
            - -s3.port.iceberg=0
          image: chrislusf/seaweedfs:4.29
          imagePullPolicy: IfNotPresent
          env:
            - name: AWS_ACCESS_KEY_ID
              value: seaweedfsadmin
            - name: AWS_SECRET_ACCESS_KEY
              value: seaweedfsadmin
            - name: S3_BUCKET
              value: thanos
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          ports:
            - name: s3
              containerPort: 8333
              protocol: TCP
          volumeMounts:
            - name: storage
              mountPath: /data
      volumes:
        - name: storage
          emptyDir: {}
EOF
    fi

    # SeaweedFS Service
    if [[ ! -f "$MANIFESTS_DIR/seaweedfs-service.yaml" ]]; then
        cat > "$MANIFESTS_DIR/seaweedfs-service.yaml" <<'EOF'
apiVersion: v1
kind: Service
metadata:
  name: seaweedfs
  namespace: open-cluster-management-observability
spec:
  type: ClusterIP
  ports:
    - port: 8333
      targetPort: 8333
      protocol: TCP
      name: s3
  selector:
    app.kubernetes.io/name: seaweedfs
EOF
    fi

    # Thanos object storage secret. A file generated before the SeaweedFS switch
    # still points at the MinIO service; regenerate it so MCO does not keep
    # talking to MinIO. Hand-edited files for external storage are left alone.
    local secret_file="$MANIFESTS_DIR/thanos-object-storage-secret.yaml"
    if [[ -f "$secret_file" ]] && grep 'minio.open-cluster-management-observability.svc' "$secret_file" >/dev/null; then
        log_warn "Regenerating $secret_file (it still points at the old MinIO endpoint)"
        rm -f "$secret_file"
    fi
    if [[ ! -f "$secret_file" ]]; then
        cat > "$secret_file" <<'EOF'
apiVersion: v1
kind: Secret
metadata:
  name: thanos-object-storage
  namespace: open-cluster-management-observability
type: Opaque
stringData:
  thanos.yaml: |
    type: s3
    config:
      bucket: thanos
      endpoint: seaweedfs.open-cluster-management-observability.svc:8333
      insecure: true
      access_key: seaweedfsadmin
      secret_key: seaweedfsadmin
EOF
    fi

    # MCO CR
    if [[ ! -f "$MANIFESTS_DIR/mco-cr.yaml" ]]; then
        cat > "$MANIFESTS_DIR/mco-cr.yaml" <<'EOF'
apiVersion: observability.open-cluster-management.io/v1beta2
kind: MultiClusterObservability
metadata:
  name: observability
spec:
  observabilityAddonSpec: {}
  storageConfig:
    metricObjectStorage:
      key: thanos.yaml
      name: thanos-object-storage
EOF
    fi
}

# detect_stuck_manifestworks outputs "cluster/mw-name|deletionTimestamp|age_seconds"
# lines for MCOA ManifestWorks stuck in Deleting beyond TIMEOUT_MW_STUCK.
# Scoped to local-cluster only (self-referential deadlock is local-cluster-specific).
detect_stuck_manifestworks() {
    local threshold="${TIMEOUT_MW_STUCK}"
    local now
    now=$(date +%s)
    local results=()

    local mw_list
    mw_list=$($KUBE_CLI get manifestwork -n local-cluster \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.deletionTimestamp}{"\n"}{end}' \
        2>/dev/null || echo "")

    while IFS=$'\t' read -r name deletion_ts; do
        [[ -z "$name" || -z "$deletion_ts" ]] && continue
        [[ "$name" != *"$MCOA_MW_PATTERN"* ]] && continue

        local del_epoch
        del_epoch=$(date -jf "%Y-%m-%dT%H:%M:%SZ" "$deletion_ts" +%s 2>/dev/null \
            || date -d "$deletion_ts" +%s 2>/dev/null || echo "0")
        local age=$(( now - del_epoch ))

        if [[ $age -ge $threshold ]]; then
            results+=("local-cluster/$name|$deletion_ts|$age")
        fi
    done <<< "$mw_list"

    if [[ ${#results[@]} -gt 0 ]]; then
        printf '%s\n' "${results[@]}"
    fi
}

# cleanup_stuck_manifestworks removes finalizers from stuck MCOA ManifestWorks,
# then restarts MCOA to trigger re-creation. Idempotent — no-op if none found.
cleanup_stuck_manifestworks() {
    local stuck
    stuck=$(detect_stuck_manifestworks)
    [[ -z "$stuck" ]] && { log_info "No stuck ManifestWorks found"; return 0; }

    log_substep "Cleaning up stuck ManifestWorks"
    while IFS='|' read -r entry deletion_ts age; do
        local cluster="${entry%%/*}"
        local mw_name="${entry##*/}"
        log_warn "  Removing finalizers from $mw_name in $cluster (stuck ${age}s)"
        $KUBE_CLI patch manifestwork "$mw_name" -n "$cluster" \
            --type=merge -p '{"metadata":{"finalizers":[]}}' 2>/dev/null || true
    done <<< "$stuck"

    sleep 5

    local remaining
    remaining=$(detect_stuck_manifestworks)
    if [[ -n "$remaining" ]]; then
        log_warn "Some ManifestWorks still stuck after cleanup"
    else
        log_success "Stuck ManifestWorks cleaned up"
    fi

    if $KUBE_CLI get deployment "$MCOA_DEPLOY" -n "$OBS_NAMESPACE" &>/dev/null; then
        log_substep "Restarting MCOA addon manager to trigger reconciliation"
        $KUBE_CLI rollout restart deployment/"$MCOA_DEPLOY" -n "$OBS_NAMESPACE"
        $KUBE_CLI rollout status deployment/"$MCOA_DEPLOY" -n "$OBS_NAMESPACE" \
            --timeout="${TIMEOUT_ROLLOUT}s" 2>/dev/null || true
    fi
}

do_install() {
    local skip_object_store=false
    local enable_rs=false
    local mcoa_mode=false
    local force_cleanup=false
    local wait_timeout=$TIMEOUT_MCO_READY

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --skip-object-store|--skip-minio) skip_object_store=true; shift ;;
            --enable-rightsizing)  enable_rs=true; shift ;;
            --mcoa-mode)          mcoa_mode=true; enable_rs=true; shift ;;
            --force-cleanup-mw)   force_cleanup=true; shift ;;
            --wait-timeout)       wait_timeout="$2"; shift 2 ;;
            *) log_error "Unknown option: $1"; usage; exit 1 ;;
        esac
    done

    create_manifests_if_missing

    log_step "Setting up MCO Observability"
    echo ""

    # 1. Namespace
    log_substep "Creating observability namespace"
    $KUBE_CLI apply -f "$MANIFESTS_DIR/namespace.yaml"

    # 2. Pull secret
    log_substep "Copying pull secret"
    local pull_secret
    pull_secret=$($KUBE_CLI get secret/pull-secret -n openshift-config \
        -o jsonpath='{.data.\.dockerconfigjson}' 2>/dev/null || echo "")

    if [[ -n "$pull_secret" ]]; then
        cat <<EOF | $KUBE_CLI apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: multiclusterhub-operator-pull-secret
  namespace: $OBS_NAMESPACE
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: $pull_secret
EOF
        log_success "Pull secret created"
    else
        log_warn "Could not extract pull secret from openshift-config"
        log_info "You may need to create it manually"
    fi

    # 3. SeaweedFS
    if [[ "$skip_object_store" == "false" ]]; then
        log_substep "Deploying SeaweedFS"
        $KUBE_CLI apply -f "$MANIFESTS_DIR/seaweedfs-deployment.yaml"
        $KUBE_CLI apply -f "$MANIFESTS_DIR/seaweedfs-service.yaml"

        log_substep "Waiting for SeaweedFS to be ready"
        $KUBE_CLI rollout status deployment/seaweedfs -n "$OBS_NAMESPACE" --timeout="${TIMEOUT_ROLLOUT}s"
        log_success "SeaweedFS is running"
    fi

    # 4. Thanos object storage secret
    log_substep "Creating Thanos object storage secret"
    $KUBE_CLI apply -f "$MANIFESTS_DIR/thanos-object-storage-secret.yaml"

    # 4.5 Check for stuck ManifestWorks
    local stuck_mws
    stuck_mws=$(detect_stuck_manifestworks)
    if [[ -n "$stuck_mws" ]]; then
        if [[ "$force_cleanup" == "true" ]]; then
            log_substep "Cleaning up stuck ManifestWorks (--force-cleanup-mw)"
            cleanup_stuck_manifestworks
        else
            echo ""
            log_warn "Stuck ManifestWork(s) detected — MCOA cannot reconcile until cleared:"
            while IFS='|' read -r entry deletion_ts age; do
                local cluster="${entry%%/*}"
                local mw_name="${entry##*/}"
                log_warn "  $mw_name in $cluster (${age}s)"
            done <<< "$stuck_mws"
            log_info "  Re-run with --force-cleanup-mw to remove finalizers"
        fi
    fi

    # 5. MCO CR
    log_substep "Creating MultiClusterObservability CR"
    $KUBE_CLI apply -f "$MANIFESTS_DIR/mco-cr.yaml"

    # Wait for MCO to be ready
    log_substep "Waiting for MCO to reconcile (timeout: ${wait_timeout}s)"
    local elapsed=0
    while [[ $elapsed -lt $wait_timeout ]]; do
        local status
        status=$($KUBE_CLI get mco "$MCO_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "")
        if [[ "$status" == "True" ]]; then
            log_success "MCO is Ready"
            break
        fi
        printf "\r  Waiting for MCO... (%ds/%ds)" "$elapsed" "$wait_timeout"
        sleep 10
        elapsed=$((elapsed + 10))
    done
    echo ""

    if [[ $elapsed -ge $wait_timeout ]]; then
        log_warn "MCO not ready within timeout. Check with: $KUBE_CLI get mco $MCO_NAME -o yaml"
    fi

    # 6. Enable right-sizing
    if [[ "$enable_rs" == "true" ]]; then
        echo ""
        "$SCRIPT_DIR/rs-mode-switch" enable
        if [[ "$mcoa_mode" == "true" ]]; then
            "$SCRIPT_DIR/rs-mode-switch" mcoa
        fi
    fi

    echo ""
    print_separator
    log_success "Observability setup complete"
    print_separator
}

do_uninstall() {
    log_step "Removing MCO CR"

    if resource_exists mco "$MCO_NAME"; then
        # Read RS mode BEFORE deletion — MCO CR annotation is gone after delete
        local rs_mode
        if release_is_50; then
            rs_mode="mcoa"
        elif release_is_216; then
            rs_mode="mco"
        else
            local annotation
            # Dots in annotation key must be escaped for jsonpath
            local escaped_annotation="${RS_ANNOTATION//./\\.}"
            annotation=$(get_resource_field mco "$MCO_NAME" "" \
                "{.metadata.annotations['${escaped_annotation}']}" 2>/dev/null || true)
            [[ -n "$annotation" ]] && rs_mode="mcoa" || rs_mode="mco"
        fi

        if confirm "Delete MCO CR '$MCO_NAME'?"; then
            $KUBE_CLI delete mco "$MCO_NAME" --wait=true --timeout=120s
            log_success "MCO CR deleted"

            # Verify right-sizing resources are cleaned up
            echo ""
            log_step "Verifying right-sizing resource cleanup"
            verify_rs_cleanup "$rs_mode"
        else
            log_info "Cancelled"
        fi
    else
        log_info "MCO CR not found, nothing to delete"
    fi
}

# verify_rs_cleanup checks that right-sizing resources are cleaned up after MCO deletion.
# Usage: verify_rs_cleanup <mode>   where mode is "mco" or "mcoa"
verify_rs_cleanup() {
    local mode="${1:-mco}"
    local max_wait=$TIMEOUT_RS_CLEANUP
    local interval=5
    local elapsed=0

    while [[ $elapsed -lt $max_wait ]]; do
        local remaining=()

        # Placements in global-set (MCO mode only)
        if [[ "$mode" == "mco" ]]; then
            for name in rs-placement rs-virt-placement; do
                if $KUBE_CLI get placement "$name" -n "$GLOBAL_SET_NAMESPACE" &>/dev/null; then
                    remaining+=("placement/$name ($GLOBAL_SET_NAMESPACE)")
                fi
            done
        fi

        # MCOA uses in-memory predicate evaluation (no Placement CRs to clean up)

        # Policies and PlacementBindings (MCO mode only)
        if [[ "$mode" == "mco" ]]; then
            for name in rs-prom-rules-policy rs-virt-prom-rules-policy; do
                if $KUBE_CLI get policy.policy.open-cluster-management.io "$name" -n "$GLOBAL_SET_NAMESPACE" &>/dev/null; then
                    remaining+=("policy/$name ($GLOBAL_SET_NAMESPACE)")
                fi
            done
            for name in rs-policyset-binding rs-virt-policyset-binding; do
                if $KUBE_CLI get placementbinding "$name" -n "$GLOBAL_SET_NAMESPACE" &>/dev/null; then
                    remaining+=("placementbinding/$name ($GLOBAL_SET_NAMESPACE)")
                fi
            done
        fi

        # ConfigMaps in observability namespace (both modes — may be gone via namespace GC)
        for name in rs-namespace-config rs-virt-config; do
            if $KUBE_CLI get configmap "$name" -n "$OBS_NAMESPACE" &>/dev/null; then
                remaining+=("configmap/$name ($OBS_NAMESPACE)")
            fi
        done

        if [[ ${#remaining[@]} -eq 0 ]]; then
            log_success "All right-sizing resources cleaned up ($mode mode)"
            return 0
        fi

        log_info "Waiting for RS resource cleanup... (${elapsed}s/${max_wait}s) — ${#remaining[@]} remaining"
        sleep "$interval"
        elapsed=$((elapsed + interval))
    done

    # Report remaining resources
    log_warn "Right-sizing resources still exist after ${max_wait}s ($mode mode):"
    for r in "${remaining[@]}"; do
        log_warn "  $r"
    done
}

do_status() {
    log_step "Observability Status"
    echo ""

    # MCO CR
    if resource_exists mco "$MCO_NAME"; then
        local ready
        ready=$(get_resource_field mco "$MCO_NAME" "" '{.status.conditions[?(@.type=="Ready")].status}')
        if [[ "$ready" == "True" ]]; then
            log_success "MCO CR: Ready"
        else
            local reason
            reason=$(get_resource_field mco "$MCO_NAME" "" '{.status.conditions[?(@.type=="Ready")].message}')
            log_warn "MCO CR: Not Ready ($reason)"
        fi
    else
        log_warn "MCO CR: not found"
    fi

    # Stuck ManifestWorks
    local stuck_mws
    stuck_mws=$(detect_stuck_manifestworks)
    if [[ -n "$stuck_mws" ]]; then
        echo ""
        log_warn "Stuck ManifestWorks (blocking MCOA reconciliation):"
        while IFS='|' read -r entry deletion_ts age; do
            local cluster="${entry%%/*}"
            local mw_name="${entry##*/}"
            log_warn "  $mw_name in $cluster (since $deletion_ts, ${age}s ago)"
        done <<< "$stuck_mws"
        log_info "  Fix: bin/setup-observability install --force-cleanup-mw"
    fi

    # Key pods
    echo ""
    log_info "Key Pods:"
    for dep in observability-rbac-query-proxy observability-grafana observability-observatorium-api observability-thanos-query observability-thanos-compact observability-thanos-receive-default observability-thanos-rule; do
        if resource_exists deployment "$dep" "$OBS_NAMESPACE"; then
            local ready_replicas desired_replicas
            ready_replicas=$(get_resource_field deployment "$dep" "$OBS_NAMESPACE" '{.status.readyReplicas}')
            desired_replicas=$(get_resource_field deployment "$dep" "$OBS_NAMESPACE" '{.spec.replicas}')
            if [[ "${ready_replicas:-0}" -ge "${desired_replicas:-1}" ]]; then
                log_success "  $dep: ${ready_replicas:-0} ready"
            else
                log_warn "  $dep: ${ready_replicas:-0}/${desired_replicas:-?} ready"
            fi
        fi
    done

    # In-cluster object storage (SeaweedFS; MinIO on hubs set up before the switch)
    echo ""
    local store store_ready found_store=false
    for store in seaweedfs minio; do
        if resource_exists deployment "$store" "$OBS_NAMESPACE"; then
            store_ready=$(get_resource_field deployment "$store" "$OBS_NAMESPACE" '{.status.readyReplicas}')
            log_success "Object storage ($store): ${store_ready:-0} ready"
            found_store=true
        fi
    done
    if [[ "$found_store" == "false" ]]; then
        log_info "Object storage: no in-cluster store deployed (using external storage)"
    fi

    # Object storage secret
    if resource_exists secret thanos-object-storage "$OBS_NAMESPACE"; then
        log_success "Thanos object storage secret: exists"
    else
        log_warn "Thanos object storage secret: not found"
    fi

    # ManagedClusters
    echo ""
    log_info "ManagedClusters:"
    $KUBE_CLI get managedcluster --no-headers 2>/dev/null | while read -r line; do
        local name status
        name=$(echo "$line" | awk '{print $1}')
        status=$(echo "$line" | awk '{print $4}')
        if [[ "$status" == "True" ]]; then
            log_success "  $name: Available"
        else
            log_warn "  $name: $status"
        fi
    done

    echo ""
}

# --- Main ---
case "${1:-install}" in
    -h|--help) usage; exit 0 ;;
esac

init_acm_tools
init_hub_context
detect_release

case "${1:-install}" in
    install)    shift 2>/dev/null || true; do_install "$@" ;;
    uninstall)  do_uninstall ;;
    status)     do_status ;;
    --*)        do_install "$@" ;;
    *) log_error "Unknown command: $1"; usage; exit 1 ;;
esac
