#!/bin/bash
# =============================================================================
# upgrade-acm — Upgrade ACM and MCE on an existing hub cluster via OLM
# =============================================================================
#
# Upgrades ACM/MCE operator subscriptions via subscription.operators.coreos.com
# (plain "subscription" resolves to apps.open-cluster-management.io on ACM hubs).
#
# Usage:
#   upgrade-acm                              # ACM release-5.0 + MCE stable-5.0
#   upgrade-acm fix-mce                      # MCE only -> stable-5.0 (auto catalog)
#   upgrade-acm apply-mce-catalog              # Add mce-dev-catalog:latest-5.0
#   upgrade-acm list-channels                # Show MCE channels per catalog (like UI)
#   upgrade-acm status
#
# Notes:
#   - ACM channel: release-<version> (matches install-custom-acm / stolostron deploy)
#   - MCE channel: stable-<version>  (5.x and 2.17+); 2.16 and below: ACM minor - 5
#   - stable-5.x may only exist in mce-dev-catalog, not redhat-operators
# =============================================================================

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"

OLM_SUB="subscription.operators.coreos.com"

MCE_NAMESPACE="${MCE_NAMESPACE:-multicluster-engine}"
ACM_SUB_NAME="${ACM_SUB_NAME:-}"
MCE_SUB_NAME="${MCE_SUB_NAME:-multicluster-engine}"

# Distinguish an explicit version (--version or TARGET_VERSION env) from the 5.0
# default. --channel without --version must not wait for MCH 5.0.
if [[ -n "${TARGET_VERSION:-}" ]]; then
    TARGET_VERSION_SET=true
else
    TARGET_VERSION_SET=false
    TARGET_VERSION="5.0"
fi
ACM_CHANNEL="${ACM_CHANNEL:-}"
MCE_CHANNEL="${MCE_CHANNEL:-}"
MCE_SOURCE="${MCE_SOURCE:-}"
MCE_SOURCE_EXPLICIT=false
[[ -n "$MCE_SOURCE" ]] && MCE_SOURCE_EXPLICIT=true
MCE_SOURCE_NS="${MCE_SOURCE_NS:-openshift-marketplace}"
MCE_CATALOG_IMAGE="${MCE_CATALOG_IMAGE:-mce-dev-catalog}"
MCE_CATALOG_REGISTRY="${MCE_CATALOG_REGISTRY:-quay.io:443/acm-d}"
MCE_CATALOG_TAG="${MCE_CATALOG_TAG:-}"
WAIT_TIMEOUT="${WAIT_TIMEOUT:-$TIMEOUT_MCH_READY}"
DRY_RUN=false
FORCE_MCE=false
APPLY_MCE_CATALOG=false

_PKG_ROWS_CACHE=""
_PKG_ROWS_CACHE_KEY=""
_MCE_CATALOG_ENSURED=""

usage() {
    cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  upgrade           Patch ACM + MCE to target version (default)
  fix-mce           Upgrade MCE channel/catalog only (e.g. stable-2.17 -> stable-5.0)
  apply-mce-catalog Apply mce-dev-catalog CatalogSource (quay.io:443/acm-d/...)
  list-channels     List MCE channels per catalog source (matches console UI)
  status            Show ACM / MCH / MCE status

Options:
  --version VER           Target ACM version (default: $TARGET_VERSION)
  --channel CHANNEL       ACM OLM channel (default: release-<version>)
  --mce-channel CHANNEL   MCE OLM channel (default: stable-<version>)
  --mce-source SOURCE     MCE catalog source (default: auto-detect for channel)
  --mce-catalog-tag TAG   Dev catalog image tag (default: latest-<mce-version>)
  --apply-mce-catalog     Apply mce-dev-catalog before MCE upgrade if needed
  --wait-timeout SECS     Wait for MCH/MCE CSV/compliance (default: $WAIT_TIMEOUT)
  --force-mce             Always patch MCE subscription
  --dry-run               Show planned changes only
  -h, --help

Examples:
  $(basename "$0") list-channels
  $(basename "$0") apply-mce-catalog --mce-catalog-tag latest-5.0
  $(basename "$0") fix-mce --mce-channel stable-5.0 --apply-mce-catalog
  $(basename "$0") --channel release-5.0 --mce-channel stable-5.0
  $(basename "$0") status

Typical ACM 5.0 + MCE 5.0 flow:
  $(basename "$0") apply-mce-catalog
  $(basename "$0") --version 5.0 --apply-mce-catalog
EOF
}

derive_channels() {
    local version="$1"
    local major minor

    IFS=. read -r major minor _ <<< "${version}."
    minor="${minor:-0}"

    # ACM always uses release-X.Y (install-custom-acm, stolostron/deploy).
    if [[ -z "$ACM_CHANNEL" ]]; then
        ACM_CHANNEL="release-${major}.${minor}"
    elif [[ "$TARGET_VERSION_SET" != "true" ]]; then
        # --channel without --version: wait_for_mch and MCE derivation must
        # follow the channel, not the 5.0 default.
        TARGET_VERSION="${ACM_CHANNEL#release-}"
        TARGET_VERSION="${TARGET_VERSION#stable-}"
        IFS=. read -r major minor _ <<< "${TARGET_VERSION}."
        minor="${minor:-0}"
    fi

    # MCE: 5.x and 2.17+ share the ACM minor; <=2.16 is ACM minor - 5.
    if [[ -z "$MCE_CHANNEL" ]]; then
        if [[ "$major" == "5" ]] || [[ "$minor" -ge 17 ]]; then
            MCE_CHANNEL="stable-${major}.${minor}"
        else
            MCE_CHANNEL="stable-${major}.$((minor - 5))"
        fi
    fi

    if [[ -z "$MCE_CATALOG_TAG" ]]; then
        MCE_CATALOG_TAG="latest-${MCE_CHANNEL#stable-}"
    fi
}

parse_common_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version)           TARGET_VERSION="$2"; TARGET_VERSION_SET=true; shift 2 ;;
            --channel)           ACM_CHANNEL="$2"; shift 2 ;;
            --mce-channel)       MCE_CHANNEL="$2"; shift 2 ;;
            --mce-source)        MCE_SOURCE="$2"; MCE_SOURCE_EXPLICIT=true; shift 2 ;;
            --mce-catalog-tag)   MCE_CATALOG_TAG="$2"; shift 2 ;;
            --apply-mce-catalog) APPLY_MCE_CATALOG=true; shift ;;
            --wait-timeout)      WAIT_TIMEOUT="$2"; shift 2 ;;
            --force-mce)         FORCE_MCE=true; shift ;;
            --dry-run)           DRY_RUN=true; shift ;;
            *) log_error "Unknown option: $1"; usage; exit 1 ;;
        esac
    done
    derive_channels "$TARGET_VERSION"
}

find_acm_subscription() {
    if [[ -n "$ACM_SUB_NAME" ]] && resource_exists "$OLM_SUB" "$ACM_SUB_NAME" "$ACM_NAMESPACE"; then
        echo "$ACM_SUB_NAME"
        return 0
    fi

    local name
    name=$($KUBE_CLI get "$OLM_SUB" -n "$ACM_NAMESPACE" \
        -o jsonpath='{range .items[?(@.spec.name=="advanced-cluster-management")]}{.metadata.name}{"\n"}{end}' \
        --request-timeout=10s 2>/dev/null | head -1)
    if [[ -n "$name" ]]; then
        echo "$name"
        return 0
    fi

    for name in acm-operator-subscription advanced-cluster-management; do
        if resource_exists "$OLM_SUB" "$name" "$ACM_NAMESPACE"; then
            echo "$name"
            return 0
        fi
    done

    return 1
}

get_mce_compliance() {
    get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.mceVersionCompliance.isCompliant}' || echo ""
}

get_mce_compliance_message() {
    get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.mceVersionCompliance.message}' || echo ""
}

invalidate_package_cache() {
    _PKG_ROWS_CACHE=""
    _PKG_ROWS_CACHE_KEY=""
}

# List packagemanifest rows: catalog<TAB>channel<TAB>csv
list_package_catalog_rows() {
    local package="$1"
    local key="${package}/${MCE_SOURCE_NS}"

    if [[ "$_PKG_ROWS_CACHE_KEY" == "$key" && -n "$_PKG_ROWS_CACHE" ]]; then
        echo "$_PKG_ROWS_CACHE"
        return 0
    fi

    _PKG_ROWS_CACHE=$($KUBE_CLI get packagemanifest -n "$MCE_SOURCE_NS" \
        -o json --request-timeout=20s 2>/dev/null | \
        jq -r --arg pkg "$package" '.items[]
            | select(.metadata.name==$pkg)
            | .status.catalogSource as $cat
            | .status.channels[]
            | "\($cat)\t\(.name)\t\(.currentCSV)"' 2>/dev/null || true)
    _PKG_ROWS_CACHE_KEY="$key"
    echo "$_PKG_ROWS_CACHE"
}

list_mce_catalog_rows() {
    list_package_catalog_rows "multicluster-engine"
}

# Resolve best catalog source for an MCE channel.
# Prefers: explicit --mce-source > mce-dev-catalog > acm-dev-catalog > subscription source > redhat-operators
# On failure: print nothing (callers treat empty as not found). Never echo a fallback here —
# a printed line plus return 1 is captured by $(cmd || echo fallback) as two lines.
resolve_mce_catalog_source() {
    local channel="$1"
    local rows best_cat best_csv sub_src

    if [[ -n "$MCE_SOURCE" ]]; then
        echo "$MCE_SOURCE"
        return 0
    fi

    rows=$(list_mce_catalog_rows | awk -F'\t' -v c="$channel" '$2==c')
    if [[ -z "$rows" ]]; then
        log_warn "Channel '$channel' not found in any catalog packagemanifest" >&2
        return 1
    fi

    sub_src=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.spec.source}' 2>/dev/null || echo "")

    for prefer in mce-dev-catalog acm-dev-catalog "$sub_src" redhat-operators; do
        [[ -z "$prefer" ]] && continue
        best_csv=$(echo "$rows" | awk -F'\t' -v p="$prefer" '$1==p {print $3; exit}')
        if [[ -n "$best_csv" ]]; then
            log_info "Resolved MCE catalog: $prefer (channel $channel -> $best_csv)" >&2
            echo "$prefer"
            return 0
        fi
    done

    best_cat=$(echo "$rows" | head -1 | cut -f1)
    best_csv=$(echo "$rows" | head -1 | cut -f3)
    log_info "Resolved MCE catalog: $best_cat (channel $channel -> $best_csv)" >&2
    echo "$best_cat"
}

# Resolve best catalog source for an ACM channel.
# Prefers: current subscription source > acm-dev-catalog > redhat-operators
resolve_acm_catalog_source() {
    local channel="$1" current_source="${2:-}"
    local rows best_csv

    rows=$(list_package_catalog_rows "advanced-cluster-management" | awk -F'\t' -v c="$channel" '$2==c')
    if [[ -z "$rows" ]]; then
        log_warn "ACM channel '$channel' not found in any catalog" >&2
        return 1
    fi

    for prefer in "$current_source" acm-dev-catalog redhat-operators; do
        [[ -z "$prefer" ]] && continue
        best_csv=$(echo "$rows" | awk -F'\t' -v p="$prefer" '$1==p {print $3; exit}')
        if [[ -n "$best_csv" ]]; then
            log_info "Resolved ACM catalog: $prefer (channel $channel -> $best_csv)" >&2
            echo "$prefer"
            return 0
        fi
    done

    local best_cat
    best_cat=$(echo "$rows" | head -1 | cut -f1)
    best_csv=$(echo "$rows" | head -1 | cut -f3)
    log_info "Resolved ACM catalog: $best_cat (channel $channel -> $best_csv)" >&2
    echo "$best_cat"
}

get_catalog_csv_for_channel() {
    local package="$1" channel="$2" source="${3:-}"
    local rows
    rows=$(list_package_catalog_rows "$package")
    if [[ -n "$source" ]]; then
        echo "$rows" | awk -F'\t' -v s="$source" -v c="$channel" '$1==s && $2==c {print $3; exit}'
        return 0
    fi
    echo "$rows" | awk -F'\t' -v c="$channel" '$2==c {print $3; exit}'
}

version_matches_target() {
    local actual="$1" target="$2"
    [[ -n "$actual" && -n "$target" ]] || return 1
    [[ "$actual" == "$target" || "$actual" == "$target".* ]]
}

wait_for_catalog_source() {
    local cs_name="$1" timeout="${2:-$WAIT_TIMEOUT}"
    local elapsed=0 state
    log_substep "Waiting for CatalogSource $cs_name to be READY..."
    while [[ $elapsed -lt $timeout ]]; do
        state=$($KUBE_CLI get catalogsource "$cs_name" -n "$MCE_SOURCE_NS" \
            -o jsonpath='{.status.connectionState.lastObservedState}' 2>/dev/null || echo "")
        if [[ "$state" == "READY" ]]; then
            log_success "CatalogSource $cs_name is READY"
            return 0
        fi
        printf "\r  CatalogSource %s: %-20s (%ds/%ds)" "$cs_name" "${state:-Pending}" "$elapsed" "$timeout"
        sleep 15
        elapsed=$((elapsed + 15))
    done
    echo ""
    log_warn "CatalogSource $cs_name not READY within ${timeout}s"
    return 1
}

apply_mce_dev_catalog() {
    local image="${MCE_CATALOG_REGISTRY}/${MCE_CATALOG_IMAGE}:${MCE_CATALOG_TAG}"
    log_substep "Applying MCE CatalogSource: $image (namespace $MCE_SOURCE_NS)"

    # Honour an explicit --mce-source. Only default the subscription source to the
    # CatalogSource we create when the caller did not pin a source. Set this on the
    # dry-run path too so the preview matches the real run.
    if [[ "$MCE_SOURCE_EXPLICIT" == "true" ]]; then
        if [[ "$MCE_SOURCE" != "$MCE_CATALOG_IMAGE" ]]; then
            log_warn "Keeping --mce-source $MCE_SOURCE (CatalogSource name remains $MCE_CATALOG_IMAGE)"
        fi
    else
        MCE_SOURCE="$MCE_CATALOG_IMAGE"
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "[dry-run] apply CatalogSource $MCE_CATALOG_IMAGE image=$image namespace=$MCE_SOURCE_NS"
        return 0
    fi

    cat <<EOF | $KUBE_CLI apply -f -
apiVersion: operators.coreos.com/v1alpha1
kind: CatalogSource
metadata:
  name: $MCE_CATALOG_IMAGE
  namespace: $MCE_SOURCE_NS
spec:
  displayName: MultiCluster Engine Dev
  image: $image
  publisher: Red Hat
  sourceType: grpc
  updateStrategy:
    registryPoll:
      interval: 10m
EOF
    wait_for_catalog_source "$MCE_CATALOG_IMAGE" "$WAIT_TIMEOUT" || true
    invalidate_package_cache
    log_success "MCE dev catalog applied (source: $MCE_CATALOG_IMAGE)"
}

ensure_mce_catalog_for_channel() {
    local channel="$1"
    local resolved

    if [[ "$_MCE_CATALOG_ENSURED" == "$channel" && -n "$MCE_SOURCE" ]]; then
        return 0
    fi

    resolved=$(resolve_mce_catalog_source "$channel") || resolved=""
    resolved=$(printf '%s' "$resolved" | tr -d '\n')
    if [[ -n "$resolved" ]] && [[ "$(get_catalog_csv_for_channel "multicluster-engine" "$channel" "$resolved")" != "" ]]; then
        MCE_SOURCE="$resolved"
        _MCE_CATALOG_ENSURED="$channel"
        return 0
    fi

    if [[ "$APPLY_MCE_CATALOG" == "true" ]]; then
        log_warn "Channel $channel not in existing catalogs — applying dev catalog"
        apply_mce_dev_catalog
        resolved=$(resolve_mce_catalog_source "$channel") || resolved="$MCE_CATALOG_IMAGE"
        resolved=$(printf '%s' "$resolved" | tr -d '\n')
        MCE_SOURCE="${resolved:-$MCE_CATALOG_IMAGE}"
        _MCE_CATALOG_ENSURED="$channel"
        return 0
    fi

    log_error "Channel '$channel' not available. Run: $(basename "$0") apply-mce-catalog"
    log_info "Or: $(basename "$0") list-channels"
    log_info "Or pass --apply-mce-catalog"
    return 1
}

patch_mch_mce_annotation() {
    if ! resource_exists multiclusterhub multiclusterhub "$ACM_NAMESPACE"; then
        log_warn "MultiClusterHub not found — skipping mce-subscription-spec annotation"
        return 0
    fi

    local mce_sub_spec
    # Keep installPlanApproval in the annotation so MCH re-templates match the
    # direct subscription patch (Automatic). install-custom-acm only annotates
    # because it creates MCH from scratch; on upgrade the subscription already
    # exists and the patch starts OLM immediately.
    mce_sub_spec=$(jq -nc \
        --arg ch "$MCE_CHANNEL" \
        --arg src "$MCE_SOURCE" \
        --arg ns "$MCE_SOURCE_NS" \
        '{channel: $ch, source: $src, sourceNamespace: $ns, installPlanApproval: "Automatic"}')

    log_substep "Updating MCH mce-subscription-spec (source=$MCE_SOURCE channel=$MCE_CHANNEL)"
    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "[dry-run] annotate mch mce-subscription-spec='$mce_sub_spec'"
        return 0
    fi

    $KUBE_CLI annotate mch multiclusterhub -n "$ACM_NAMESPACE" \
        installer.open-cluster-management.io/mce-subscription-spec="$mce_sub_spec" \
        --overwrite
    log_success "MCH annotation updated"
}

patch_mce_subscription() {
    local force="${1:-false}"
    local current installed src catalog_csv need_patch=false

    current=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.spec.channel}' || echo "")
    src=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.spec.source}' || echo "")
    installed=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.status.installedCSV}' || echo "")
    catalog_csv=$(get_catalog_csv_for_channel "multicluster-engine" "$MCE_CHANNEL" "$MCE_SOURCE")

    [[ "$current" != "$MCE_CHANNEL" ]] && need_patch=true
    [[ "$src" != "$MCE_SOURCE" ]] && need_patch=true
    [[ -n "$catalog_csv" && -n "$installed" && "$catalog_csv" != "$installed" ]] && need_patch=true
    [[ "$force" == "true" ]] && need_patch=true

    if [[ "$need_patch" != "true" ]]; then
        log_success "MCE already on source=$MCE_SOURCE channel=$MCE_CHANNEL (csv: ${installed:-<pending>})"
        return 0
    fi

    log_substep "Patching MCE $OLM_SUB: source ${src:-<none>} -> $MCE_SOURCE, channel ${current:-<none>} -> $MCE_CHANNEL"
    if [[ -n "$catalog_csv" ]]; then
        log_info "Target CSV: $catalog_csv (installed: ${installed:-none})"
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "[dry-run] oc patch $OLM_SUB $MCE_SUB_NAME source=$MCE_SOURCE channel=$MCE_CHANNEL"
        return 0
    fi

    $KUBE_CLI patch "$OLM_SUB" "$MCE_SUB_NAME" -n "$MCE_NAMESPACE" --type=merge -p "{
        \"spec\": {
            \"channel\": \"$MCE_CHANNEL\",
            \"source\": \"$MCE_SOURCE\",
            \"sourceNamespace\": \"$MCE_SOURCE_NS\",
            \"installPlanApproval\": \"Automatic\"
        }
    }"
    log_success "MCE subscription patched"
}

patch_acm_subscription() {
    local sub_name="$1" acm_source="${2:-}"
    local current installed current_src need_patch=false

    current=$(get_resource_field "$OLM_SUB" "$sub_name" "$ACM_NAMESPACE" '{.spec.channel}' || echo "")
    current_src=$(get_resource_field "$OLM_SUB" "$sub_name" "$ACM_NAMESPACE" '{.spec.source}' || echo "")
    installed=$(get_resource_field "$OLM_SUB" "$sub_name" "$ACM_NAMESPACE" '{.status.installedCSV}' || echo "")

    [[ "$current" != "$ACM_CHANNEL" ]] && need_patch=true
    [[ -n "$acm_source" && "$current_src" != "$acm_source" ]] && need_patch=true

    if [[ "$need_patch" != "true" ]]; then
        log_info "ACM already on channel $ACM_CHANNEL source=$current_src (csv: ${installed:-<pending>})"
        return 0
    fi

    log_substep "Patching ACM $OLM_SUB: channel ${current:-<none>} -> $ACM_CHANNEL, source ${current_src:-<none>} -> ${acm_source:-$current_src}"
    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "[dry-run] oc patch $OLM_SUB $sub_name channel=$ACM_CHANNEL source=${acm_source:-$current_src}"
        return 0
    fi

    local patch_json="{\"spec\":{\"channel\":\"$ACM_CHANNEL\",\"installPlanApproval\":\"Automatic\""
    if [[ -n "$acm_source" ]]; then
        patch_json+=",\"source\":\"$acm_source\",\"sourceNamespace\":\"$MCE_SOURCE_NS\""
    fi
    patch_json+="}}"

    $KUBE_CLI patch "$OLM_SUB" "$sub_name" -n "$ACM_NAMESPACE" --type=merge -p "$patch_json"
    log_success "ACM subscription patched"
}

# Wait until installedCSV is Succeeded AND matches expected_csv from the catalog.
# If expected_csv is empty, require installedCSV to differ from previous_csv so we
# never report success on the pre-upgrade CSV.
wait_for_csv() {
    local sub_name="$1" namespace="$2" label="$3" expected_csv="${4:-}" timeout="${5:-$WAIT_TIMEOUT}" previous_csv="${6:-}"
    local elapsed=0 csv_name csv_phase=""

    log_substep "Waiting for $label CSV (timeout: ${timeout}s)..."
    if [[ -n "$expected_csv" ]]; then
        log_info "Expecting $label CSV: $expected_csv"
    elif [[ -n "$previous_csv" ]]; then
        log_info "Expecting $label CSV to change from $previous_csv"
    else
        log_warn "No expected $label CSV resolved from catalog — waiting for a CSV change"
    fi

    while [[ $elapsed -lt $timeout ]]; do
        csv_name=$(get_resource_field "$OLM_SUB" "$sub_name" "$namespace" '{.status.installedCSV}' || echo "")
        if [[ -n "$csv_name" ]]; then
            csv_phase=$(get_resource_field csv "$csv_name" "$namespace" '{.status.phase}' || echo "")
            if [[ "$csv_phase" == "Succeeded" ]]; then
                # Exact catalog CSV, or the same CSV with a snapshot suffix (v5.0.0-DOWNSTREAM-...).
                if [[ -n "$expected_csv" && ( "$csv_name" == "$expected_csv" || "$csv_name" == "$expected_csv"-* ) ]]; then
                    log_success "$label CSV ready: $csv_name"
                    return 0
                fi
                if [[ -z "$expected_csv" && -n "$previous_csv" && "$csv_name" != "$previous_csv" ]]; then
                    log_success "$label CSV ready: $csv_name"
                    return 0
                fi
            fi
        else
            csv_phase="Pending"
        fi
        printf "\r  $label CSV: %-28s (%ds/%ds)" "${csv_name:-Pending}/${csv_phase:-?}" "$elapsed" "$timeout"
        sleep 10
        elapsed=$((elapsed + 10))
    done
    echo ""
    log_warn "$label CSV not ready within ${timeout}s (last: ${csv_name:-none})"
    return 1
}

wait_for_mch() {
    local target_version="${1:-$TARGET_VERSION}"
    local elapsed=0 phase="" current="" desired=""

    log_substep "Waiting for MCH Running at $target_version (timeout: ${WAIT_TIMEOUT}s)..."
    while [[ $elapsed -lt $WAIT_TIMEOUT ]]; do
        phase=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.phase}' || echo "")
        current=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.currentVersion}' || echo "")
        desired=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.desiredVersion}' || echo "")
        if [[ "$phase" == "Running" && -n "$desired" && "$current" == "$desired" ]] && \
           version_matches_target "$current" "$target_version"; then
            log_success "MCH Running at $current"
            return 0
        fi
        printf "\r  MCH: phase=%-12s current=%-12s desired=%-12s (%ds/%ds)" \
            "${phase:-Pending}" "${current:-?}" "${desired:-?}" "$elapsed" "$WAIT_TIMEOUT"
        sleep 15
        elapsed=$((elapsed + 15))
    done
    echo ""
    log_warn "MCH not Running at $target_version within ${WAIT_TIMEOUT}s"
    return 1
}

wait_for_mce_compliance() {
    local elapsed=0 compliant="" timeout="${1:-$WAIT_TIMEOUT}"

    log_substep "Waiting for mceVersionCompliance=true (timeout: ${timeout}s)..."
    while [[ $elapsed -lt $timeout ]]; do
        compliant=$(get_mce_compliance)
        if [[ "$compliant" == "true" ]]; then
            log_success "MCE version compliance: true"
            return 0
        fi
        printf "\r  mceCompliant=%-6s (%ds/%ds)" "${compliant:-?}" "$elapsed" "$timeout"
        sleep 15
        elapsed=$((elapsed + 15))
    done
    echo ""
    log_warn "MCE still not compliant: $(get_mce_compliance_message)"
    return 1
}

fix_mce_subscription() {
    if ! resource_exists "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE"; then
        log_error "MCE OLM subscription not found in $MCE_NAMESPACE"
        log_info "List: oc get $OLM_SUB -n $MCE_NAMESPACE"
        return 1
    fi

    ensure_mce_catalog_for_channel "$MCE_CHANNEL" || return 1

    local msg
    msg=$(get_mce_compliance_message)
    [[ -n "$msg" && "$(get_mce_compliance)" != "true" ]] && log_warn "MCE compliance: $msg"

    local previous_csv
    previous_csv=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.status.installedCSV}' || echo "")

    patch_mch_mce_annotation
    patch_mce_subscription "$FORCE_MCE"

    if [[ "$DRY_RUN" == "true" ]]; then
        return 0
    fi

    local target_csv
    target_csv=$(get_catalog_csv_for_channel "multicluster-engine" "$MCE_CHANNEL" "$MCE_SOURCE")
    wait_for_csv "$MCE_SUB_NAME" "$MCE_NAMESPACE" "MCE" "$target_csv" "$WAIT_TIMEOUT" "$previous_csv" || true
    wait_for_mce_compliance "$WAIT_TIMEOUT" || true
}

do_list_channels() {
    log_step "MCE channels by catalog source"
    echo ""
    printf "%-24s %-14s %s\n" "CATALOG" "CHANNEL" "CURRENT_CSV"
    printf "%-24s %-14s %s\n" "-------" "-------" "-----------"
    list_mce_catalog_rows | while IFS=$'\t' read -r cat ch csv; do
        printf "%-24s %-14s %s\n" "$cat" "$ch" "$csv"
    done
    echo ""
    log_info "Console UI shows channels from the subscription's catalog source."
    log_info "Use: $(basename "$0") fix-mce --mce-channel stable-5.0 --apply-mce-catalog"
}

do_apply_mce_catalog() {
    parse_common_options "$@"
    log_target_cluster
    log_step "Apply MCE dev catalog ($MCE_CATALOG_IMAGE:$MCE_CATALOG_TAG)"
    apply_mce_dev_catalog
    echo ""
    do_list_channels
}

do_status() {
    log_target_cluster
    log_step "ACM / MCH / MCE Upgrade Status"
    echo ""

    local acm_sub
    acm_sub=$(find_acm_subscription 2>/dev/null || echo "")

    if [[ -n "$acm_sub" ]]; then
        local ch csv src
        ch=$(get_resource_field "$OLM_SUB" "$acm_sub" "$ACM_NAMESPACE" '{.spec.channel}' || echo "")
        csv=$(get_resource_field "$OLM_SUB" "$acm_sub" "$ACM_NAMESPACE" '{.status.installedCSV}' || echo "")
        log_info "ACM ($acm_sub): channel=$ch csv=${csv:-<pending>}"
    else
        log_warn "ACM subscription not found"
    fi

    if resource_exists multiclusterhub multiclusterhub "$ACM_NAMESPACE"; then
        local phase cur des compliant msg mce_req
        phase=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.phase}' || echo "")
        cur=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.currentVersion}' || echo "")
        des=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.desiredVersion}' || echo "")
        compliant=$(get_mce_compliance)
        msg=$(get_mce_compliance_message)
        mce_req=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.mceVersionCompliance.requiredChannel}' || echo "")
        log_info "MCH: phase=$phase acm=$cur desired=$des mceCompliant=$compliant required=$mce_req"
        [[ -n "$msg" && "$compliant" != "true" ]] && log_warn "  $msg"
    fi

    if resource_exists "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE"; then
        local mce_ch mce_src mce_csv target_csv
        mce_ch=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.spec.channel}' || echo "")
        mce_src=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.spec.source}' || echo "")
        mce_csv=$(get_resource_field "$OLM_SUB" "$MCE_SUB_NAME" "$MCE_NAMESPACE" '{.status.installedCSV}' || echo "")
        target_csv=$(get_catalog_csv_for_channel "multicluster-engine" "${mce_ch:-$MCE_CHANNEL}" "$mce_src")
        log_info "MCE ($OLM_SUB): source=$mce_src channel=$mce_ch csv=${mce_csv:-<pending>}"
        [[ -n "$target_csv" && "$target_csv" != "$mce_csv" ]] && \
            log_warn "  catalog offers $target_csv for channel ${mce_ch:-$MCE_CHANNEL}"
    fi

    if resource_exists mce multiclusterengine "$MCE_NAMESPACE"; then
        local mce_phase mce_cur
        mce_phase=$($KUBE_CLI get mce -n "$MCE_NAMESPACE" -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "")
        mce_cur=$($KUBE_CLI get mce -n "$MCE_NAMESPACE" -o jsonpath='{.items[0].status.currentVersion}' 2>/dev/null || echo "")
        log_info "MCE CR: phase=$mce_phase version=$mce_cur"
    fi
}

do_fix_mce() {
    parse_common_options "$@"
    FORCE_MCE=true

    log_target_cluster
    log_step "Upgrade MCE to $MCE_CHANNEL (source auto-detected)"
    [[ "$DRY_RUN" == "true" ]] && log_warn "Dry-run mode"
    echo ""

    fix_mce_subscription || exit 1

    echo ""
    print_separator
    do_status
    print_separator
}

do_upgrade() {
    parse_common_options "$@"

    log_target_cluster
    log_step "Upgrade ACM $TARGET_VERSION (ACM $ACM_CHANNEL, MCE $MCE_CHANNEL)"
    [[ "$DRY_RUN" == "true" ]] && log_warn "Dry-run mode"
    echo ""

    if ! resource_exists multiclusterhub multiclusterhub "$ACM_NAMESPACE"; then
        log_error "MultiClusterHub not found — install ACM first"
        exit 1
    fi

    local acm_sub
    acm_sub=$(find_acm_subscription) || { log_error "ACM subscription not found"; exit 1; }

    local mch_phase
    mch_phase=$(get_resource_field mch multiclusterhub "$ACM_NAMESPACE" '{.status.phase}' || echo "")
    [[ "$mch_phase" == "MCHpaused" ]] && { log_error "MCH is paused"; exit 1; }

    local acm_src previous_acm_csv target_acm_csv acm_resolved_src
    acm_src=$(get_resource_field "$OLM_SUB" "$acm_sub" "$ACM_NAMESPACE" '{.spec.source}' || echo "")
    previous_acm_csv=$(get_resource_field "$OLM_SUB" "$acm_sub" "$ACM_NAMESPACE" '{.status.installedCSV}' || echo "")

    # Check if the target channel exists in the current source; if not, find one that has it
    target_acm_csv=$(get_catalog_csv_for_channel "advanced-cluster-management" "$ACM_CHANNEL" "$acm_src")
    if [[ -n "$target_acm_csv" ]]; then
        acm_resolved_src="$acm_src"
    else
        # Guard against transient CatalogSource unavailability: when the current
        # catalog's registry pod is restarting or not READY, package-server drops
        # its PackageManifest rows. Treat a non-READY catalog as "transiently
        # invisible" and keep the current source rather than switching.
        local acm_cs_state
        acm_cs_state=$($KUBE_CLI get catalogsource "$acm_src" -n "$MCE_SOURCE_NS" \
            -o jsonpath='{.status.connectionState.lastObservedState}' 2>/dev/null || echo "")
        if [[ -n "$acm_src" && "$acm_cs_state" != "READY" ]]; then
            log_warn "CatalogSource $acm_src is not READY (state: ${acm_cs_state:-unknown}) — keeping current source"
            acm_resolved_src="$acm_src"
        else
            # Catalog is READY but genuinely doesn't carry the target channel —
            # resolve an alternative catalog.
            acm_resolved_src=$(resolve_acm_catalog_source "$ACM_CHANNEL" "$acm_src") || acm_resolved_src=""
            if [[ -n "$acm_resolved_src" ]]; then
                target_acm_csv=$(get_catalog_csv_for_channel "advanced-cluster-management" "$ACM_CHANNEL" "$acm_resolved_src")
                log_info "ACM channel $ACM_CHANNEL not in $acm_src — using $acm_resolved_src"
            else
                # Mirror MCE path: fail fast with remediation hints instead of
                # patching a channel no catalog carries (leaves sub unresolvable).
                log_error "ACM channel '$ACM_CHANNEL' not available in any catalog"
                log_info "Create the dev catalog first:"
                log_info "  install-custom-acm --catalog-source --version ${TARGET_VERSION}"
                exit 1
            fi
        fi
    fi

    patch_acm_subscription "$acm_sub" "$acm_resolved_src"

    if [[ "$DRY_RUN" == "true" ]]; then
        fix_mce_subscription || true
        print_separator
        log_info "Dry-run complete"
        print_separator
        return 0
    fi

    # ACM operator first, then MCE. Waiting for MCH Running before MCE would stall
    # for WAIT_TIMEOUT if MCH is blocked on mceVersionCompliance.
    wait_for_csv "$acm_sub" "$ACM_NAMESPACE" "ACM" "$target_acm_csv" "$WAIT_TIMEOUT" "$previous_acm_csv" || true
    fix_mce_subscription || true
    wait_for_mch "$TARGET_VERSION" || true

    echo ""
    print_separator
    do_status
    print_separator
}

# --- Main ---
case "${1:-upgrade}" in
    -h|--help) usage; exit 0 ;;
esac

init_acm_tools
init_hub_context

case "${1:-upgrade}" in
    upgrade)           shift 2>/dev/null || true; do_upgrade "$@" ;;
    fix-mce)           shift; do_fix_mce "$@" ;;
    apply-mce-catalog) shift; do_apply_mce_catalog "$@" ;;
    list-channels)     do_list_channels ;;
    status)            do_status ;;
    --*)               do_upgrade "$@" ;;
    *)                 log_error "Unknown command: $1"; usage; exit 1 ;;
esac
